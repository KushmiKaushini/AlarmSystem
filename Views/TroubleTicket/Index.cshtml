@model AlarmSystem.ViewModels.TroubleTicketViewModel

@{
    ViewData["Title"] = "TROUBLE TICKET REPORT";
}

<h2 class="text-primary mb-4">
    TROUBLE TICKET REPORT
</h2>

<form asp-action="Index" method="get">

    <div class="row mb-4">

        <div class="col-md-4">
            <label><b>FROM</b></label>

            <input asp-for="From"
                   type="date"
                   class="form-control" />
        </div>

        <div class="col-md-4">
            <label><b>TO</b></label>

            <input asp-for="To"
                   type="date"
                   class="form-control" />
        </div>

        <div class="col-md-4 d-flex align-items-end">

            <button class="btn btn-primary w-100">
                SEARCH
            </button>

        </div>

    </div>

</form>

<h5 class="mb-3">
    Total Records :
    <span class="badge bg-primary">
        @Model.Tickets.Count
    </span>
</h5>

<div class="table-responsive">

<table class="table table-bordered table-striped table-hover">

<thead class="table-dark">

<tr>

    <th>ID</th>

    <th>NODE</th>

    <th>SEVERITY</th>

    <th>TICKET TYPE</th>

    <th>PLATFORM</th>

    <th>WORKGROUP</th>

    <th>DESCRIPTION</th>

    <th>ISSUE TIME</th>

    <th>REPORTING TIME</th>

</tr>

</thead>

<tbody>

@foreach (var item in Model.Tickets)
{
    <tr>

        <td>@item.ID</td>

        <td>@item.NODE</td>

        <td>@item.SEVERITY</td>

        <td>@item.TICKET_TYPE</td>

        <td>@item.PLATFORM</td>

        <td>@item.WORKGROUP</td>

        <td>@item.DESCRIPTION</td>

        <td>
            @(item.ISSUE_TIME?.ToString("dd/MM/yyyy hh:mm:ss tt"))
        </td>

        <td>
            @(item.REPORTING_TIME?.ToString("dd/MM/yyyy hh:mm:ss tt"))
        </td>

    </tr>
}

</tbody>

</table>

</div>