@{
    ViewData["Title"] = "Daily Email Report Preview";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .report-card {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 20px 24px;
        margin-bottom: 20px;
        background: #ffffff;
        box-shadow: 0 1px 4px rgba(0,0,0,.07);
        transition: box-shadow .2s;
    }

    .report-card:hover {
        box-shadow: 0 4px 14px rgba(0,0,0,.12);
    }

    .report-card .report-icon {
        font-size: 28px;
        margin-bottom: 8px;
    }

    .report-card h5 {
        font-weight: 700;
        margin-bottom: 6px;
        color: #1a3c5e;
    }

    .report-card p.desc {
        font-size: 13px;
        color: #6c757d;
        margin-bottom: 14px;
        min-height: 38px;
    }

    .badge-type {
        font-size: 11px;
        font-weight: 600;
        border-radius: 20px;
        padding: 3px 10px;
        margin-right: 6px;
    }
</style>

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex align-items-center mb-4">
        <div>
            <h3 class="mb-0" style="color:#1a3c5e;">
                <i class="bi bi-envelope-paper-fill me-2"></i>Daily Email Report Preview
            </h3>
            <small class="text-muted">
                Preview each automated daily report email exactly as it will appear in the recipient's inbox.
                Data is fetched live from the TMS database.
            </small>
        </div>
    </div>

    <!-- Alert -->
    <div class="alert alert-info alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-info-circle-fill me-1"></i>
        Click <strong>Preview</strong> on any card to open the live-rendered email in a new browser tab.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>

    <!-- Report Cards Row -->
    <div class="row g-4">

        <!-- TYPE 1 -->
        <div class="col-md-6 col-xl-3">
            <div class="report-card">
                <div class="report-icon">📋</div>
                <span class="badge bg-primary badge-type">Type 1</span>
                <h5 class="mt-2">Regional Network Teams</h5>
                <p class="desc">
                    Pending Data Faults related to <strong>Regional Network Teams</strong>.
                    Includes circuit ID, customer details, work-order location and duration.
                </p>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("Preview", "DailyEmailReport", new { type = 1 })"
                       target="_blank"
                       class="btn btn-primary btn-sm flex-grow-1">
                        <i class="bi bi-eye me-1"></i>Preview
                    </a>
                    <a href="@Url.Action("Subject", "DailyEmailReport", new { type = 1 })"
                       target="_blank"
                       class="btn btn-outline-secondary btn-sm"
                       title="View subject line">
                        <i class="bi bi-chat-square-text"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- TYPE 2 -->
        <div class="col-md-6 col-xl-3">
            <div class="report-card">
                <div class="report-icon">📡</div>
                <span class="badge bg-warning text-dark badge-type">Type 2</span>
                <h5 class="mt-2">Pending OPMC Faults</h5>
                <p class="desc">
                    Faults pending with the <strong>OPMC (Operations &amp; Maintenance Centre)</strong>
                    teams, reported as at 07:00 AM. Includes LEA, DGM, GM &amp; recent update.
                </p>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("Preview", "DailyEmailReport", new { type = 2 })"
                       target="_blank"
                       class="btn btn-warning btn-sm flex-grow-1 text-dark">
                        <i class="bi bi-eye me-1"></i>Preview
                    </a>
                    <a href="@Url.Action("Subject", "DailyEmailReport", new { type = 2 })"
                       target="_blank"
                       class="btn btn-outline-secondary btn-sm"
                       title="View subject line">
                        <i class="bi bi-chat-square-text"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- TYPE 3 -->
        <div class="col-md-6 col-xl-3">
            <div class="report-card">
                <div class="report-icon">🏢</div>
                <span class="badge bg-success badge-type">Type 3</span>
                <h5 class="mt-2">SLT NOC Fault Management</h5>
                <p class="desc">
                    Pending Data Faults relating to <strong>SLT NOC – Fault Management Teams</strong>
                    as at 00:00 hrs. Mirrors the Type 1 column layout with NOC-specific context.
                </p>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("Preview", "DailyEmailReport", new { type = 3 })"
                       target="_blank"
                       class="btn btn-success btn-sm flex-grow-1">
                        <i class="bi bi-eye me-1"></i>Preview
                    </a>
                    <a href="@Url.Action("Subject", "DailyEmailReport", new { type = 3 })"
                       target="_blank"
                       class="btn btn-outline-secondary btn-sm"
                       title="View subject line">
                        <i class="bi bi-chat-square-text"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- TYPE 4 -->
        <div class="col-md-6 col-xl-3">
            <div class="report-card" style="border-top: 3px solid #1a3c5e;">
                <div class="report-icon">📊</div>
                <span class="badge bg-danger badge-type">Type 4</span>
                <h5 class="mt-2">Daily Network Failures</h5>
                <p class="desc">
                    Full <strong>Network Failure Summary Report</strong>: MSAN count, CEA nodes,
                    SLT 4G sites, TX faults, and Other Services (MPLS/DATA/ISP/IPTV).
                </p>
                <div class="d-flex gap-2">
                    <a href="@Url.Action("Preview", "DailyEmailReport", new { type = 4 })"
                       target="_blank"
                       class="btn btn-danger btn-sm flex-grow-1">
                        <i class="bi bi-eye me-1"></i>Preview
                    </a>
                    <a href="@Url.Action("Subject", "DailyEmailReport", new { type = 4 })"
                       target="_blank"
                       class="btn btn-outline-secondary btn-sm"
                       title="View subject line">
                        <i class="bi bi-chat-square-text"></i>
                    </a>
                </div>
            </div>
        </div>

    </div><!-- /row -->

    <!-- Quick Reference Table -->
    <div class="card mt-4 border-0 shadow-sm">
        <div class="card-header bg-light fw-bold" style="font-size:13px;">
            <i class="bi bi-table me-1"></i>Quick Reference — Email Subjects
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-striped table-bordered mb-0" style="font-size:12.5px;">
                <thead class="table-dark">
                    <tr>
                        <th style="width:60px;">Type</th>
                        <th>Subject Line</th>
                        <th style="width:90px;">Time</th>
                        <th style="width:100px;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="badge bg-primary">1</span></td>
                        <td>Pending Data Faults Related to Regional Network Teams on [Date]</td>
                        <td>Daily</td>
                        <td><a href="@Url.Action("Preview","DailyEmailReport",new{type=1})" target="_blank" class="btn btn-xs btn-outline-primary" style="font-size:11px;padding:2px 8px;">Open</a></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-warning text-dark">2</span></td>
                        <td>Pending Data fault related to OPMC [Date]</td>
                        <td>07:00 AM</td>
                        <td><a href="@Url.Action("Preview","DailyEmailReport",new{type=2})" target="_blank" class="btn btn-xs btn-outline-warning" style="font-size:11px;padding:2px 8px;">Open</a></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-success">3</span></td>
                        <td>Pending Data Faults Related to SLT NOC - Fault Management Teams on [Date]</td>
                        <td>00:00 hrs</td>
                        <td><a href="@Url.Action("Preview","DailyEmailReport",new{type=3})" target="_blank" class="btn btn-xs btn-outline-success" style="font-size:11px;padding:2px 8px;">Open</a></td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-danger">4</span></td>
                        <td>Pending Network Failures as at 08:00 AM on [Date]</td>
                        <td>08:00 AM</td>
                        <td><a href="@Url.Action("Preview","DailyEmailReport",new{type=4})" target="_blank" class="btn btn-xs btn-outline-danger" style="font-size:11px;padding:2px 8px;">Open</a></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>
