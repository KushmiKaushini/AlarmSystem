@model AlarmSystem.ViewModels.SummaryCarrierFaultViewModel

@{
    ViewData["Title"] = "Carrier Customer Faults Summary";
}

<style>

.container-fluid{
    padding:20px;
}

.page-title{
    text-align:center;
    color:darkblue;
    font-weight:bold;
    margin-bottom:20px;
}

.summary-table{
    width:40%;
    margin-bottom:20px;
}

.summary-table th{
    background:#3a4f63;
    color:white;
    text-align:center;
}

.summary-table td{
    text-align:center;
    font-weight:bold;
    border:1px solid #000;
}

.main-table{
    width:100%;
    border-collapse:collapse;
    font-size:13px;
}

.main-table th,
.main-table td{
    border:1px solid black;
    padding:6px;
    text-align:center;
}

.group-area{
    background:#6c757d;
    color:white;
}

.group-cea{
    background:#0d6efd;
    color:white;
}

.group-msan{
    background:#198754;
    color:white;
}

.group-slbn{
    background:#dc3545;
    color:white;
}

</style>

<div class="container-fluid">

<h2 class="page-title">
    CARRIER CUSTOMER FAULTS SUMMARY
</h2>

<table class="table table-bordered summary-table">

<tr>
    <th>CEA</th>
    <th>MSAN</th>
    <th>SLBN</th>
</tr>

<tr>
    <td>@Model.Summary.CEA</td>
    <td>@Model.Summary.MSAN</td>
    <td>@Model.Summary.SLBN</td>
</tr>

</table>

<a asp-action="Export"
   class="btn btn-primary mb-3">
    Export To Excel
</a>

<table class="main-table">

<thead>

<tr>

<th colspan="2" class="group-area">AREA</th>

<th colspan="4" class="group-cea">CEA</th>

<th colspan="4" class="group-msan">MSAN</th>

<th colspan="4" class="group-slbn">SLBN</th>

</tr>

<tr>

<th>REGION</th>
<th>PROVINCE</th>

<th>LT1D</th>
<th>1D-3D</th>
<th>3D-7D</th>
<th>GT7D</th>

<th>LT1D</th>
<th>1D-3D</th>
<th>3D-7D</th>
<th>GT7D</th>

<th>LT1D</th>
<th>1D-3D</th>
<th>3D-7D</th>
<th>GT7D</th>

</tr>

</thead>

<tbody>

    @foreach (var item in Model.Details)
{
    <tr>

        <td>@item.REGION</td>
        <td>@item.PROVINCE</td>

        <!-- CEA -->
        <td>@item.CEA_LT1D</td>
        <td>@item.CEA_1D_3D</td>
        <td>@item.CEA_3D_7D</td>
        <td>@item.CEA_GT7D</td>

        <!-- MSAN -->
        <td>@item.MSAN_LT1D</td>
        <td>@item.MSAN_1D_3D</td>
        <td>@item.MSAN_3D_7D</td>
        <td>@item.MSAN_GT7D</td>

        <!-- SLBN -->
        <td>@item.SLBN_LT1D</td>
        <td>@item.SLBN_1D_3D</td>
        <td>@item.SLBN_3D_7D</td>
        <td>@item.SLBN_GT7D</td>

    </tr>
}

</tbody>

</table>

</div>