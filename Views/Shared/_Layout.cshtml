@using AlarmSystem.Services

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AlarmSystem</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AlarmSystem.styles.css" asp-append-version="true" />

    <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    @RenderSection("Styles", required: false)
    
</head>

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdminUser = true;
    var initialSidebarCollapsed = false;
    var bodyClass = $"bg-light {(ViewData["BodyClass"] ?? string.Empty)} has-sidebar".Trim();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var isOtherOpsArea = currentController == "Home" && new[]
    {
        "Dashboard",
        "AlarmDashboard",
        "ViewerDashboard",
        "DashboardEntry",
        "ViewData",
        "RealtimeAlarm",
        "CustomerFaultOss",
        "CustomerDetails",
        "NetworkElementDetails"
    }.Contains(currentAction);

    var isSearchArea = new[]
    {
        "CircuitId",
        "SearchByNode"
    }.Contains(currentController);

    var isSatReportsArea = currentController == "DailyEmailReport" ||
        (Context.Request.Path.Value?.Contains("preview-email", StringComparison.OrdinalIgnoreCase) == true);

    var isReportsArea = isSatReportsArea || new[]
    {
        "TodayNodeDown",
        "SummaryCarrierFaults",
        "SummaryNetworkFaults",
        "NodeDownReport",
        "ACMainFailure",
        "AlarmHistoryEngineer",
        "AlarmHistoryProvince",
        "AlarmHistoryRegion",
        "Summary",
        "Report",
        "ReportCeaPortDown"
    }.Contains(currentController);
}

<body class="@bodyClass">

    <header>
        <nav class="navbar navbar-expand-lg glass-nav">
            <div class="container">
               <div class="nav-left">

    @if (isAuthenticated)
    {
        <button id="sideMenuToggle"
                class="btn btn-sm side-menu-toggle"
                type="button"
                aria-controls="mainSideMenu"
                aria-expanded="false"
                aria-label="Show menu"
                title="Show menu">

            <span class="menu-icon">
                <span></span>
                <span></span>
                <span></span>
            </span>

        </button>
    }

    <a class="navbar-brand navbar-logo"
       asp-controller="Home"
       asp-action="Index">

        <img src="~/img/slt-logo.svg"
             class="slt-logo-header"
             alt="SLTMobitel" />

    </a>

</div>

<div class="nav-center">

    <h2 class="brand-title">
        AlarmSystem
    </h2>

    <div class="brand-subtitle">
        Network Monitoring Platform
    </div>

</div>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav"
                        aria-controls="topNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="topNav">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        @if (isAuthenticated)
                        {
                            var displayName = User.FindFirst("name")?.Value ?? User.Identity?.Name ?? "User";
                            var roleLabel = "Authenticated";

                            <li class="nav-item me-3">
                                <div class="profile-card">
                                    <div class="profile-icon">
                                        <i class="fa-solid fa-user"></i>
                                    </div>
                                    <div class="profile-info">
                                        <div class="profile-name">
                                            @displayName
                                        </div>
                                        <div class="profile-role">
                                            @roleLabel
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 d-flex align-items-center gap-2" title="Sign out of system">
                                    <i class="fa-solid fa-right-from-bracket"></i>
                                    <span>Logout</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="app-shell @(isAuthenticated ? "with-sidebar" : "without-sidebar")">
        @if (isAuthenticated)
        {
            <aside id="mainSideMenu" class="side-menu" aria-label="Main menu">
                <div id="sideMenuResizer" class="side-menu-resizer" title="Drag to resize sidebar (double-click to reset)"></div>
                <nav class="side-menu-nav">

                    <!-- ======================================================== -->
                    <!-- SECTION 1: OTHER OPERATIONS                              -->
                    <!-- ======================================================== -->
                    <div class="side-section-header">
                        <i class="fa-solid fa-users-gear"></i>
                        <span>Other Operations</span>
                    </div>

                    <a class="side-link @((currentController == "Home" && (currentAction == "Dashboard" || currentAction == "AlarmDashboard")) ? "active" : "")"
                       asp-controller="Home"
                       asp-action="Dashboard">
                        <i class="fa-solid fa-gauge-high me-1"></i> Dashboard
                    </a>
                    <a class="side-link @((currentController == "Home" && currentAction == "RealtimeAlarm") ? "active" : "")"
                       asp-controller="Home"
                       asp-action="RealtimeAlarm"
                       data-viewdata-section-key="realtime-alarms">
                        <i class="fa-solid fa-bell me-1"></i> Realtime Alarm
                    </a>
                    <a class="side-link @((currentController == "Home" && currentAction == "CustomerFaultOss") ? "active" : "")"
                       asp-controller="Home"
                       asp-action="CustomerFaultOss"
                       data-viewdata-section-key="customer-fault-oss">
                        <i class="fa-solid fa-headset me-1"></i> Customer Fault (OSS)
                    </a>
                    <a class="side-link @((currentController == "Home" && currentAction == "CustomerDetails") ? "active" : "")"
                       asp-controller="Home"
                       asp-action="CustomerDetails"
                       data-viewdata-section-key="customer-details">
                        <i class="fa-solid fa-address-card me-1"></i> Customer Details
                    </a>
                    <a class="side-link @((currentController == "Home" && currentAction == "NetworkElementDetails") ? "active" : "")"
                       asp-controller="Home"
                       asp-action="NetworkElementDetails"
                       data-viewdata-section-key="network-element-details">
                        <i class="fa-solid fa-server me-1"></i> Network Element Details
                    </a>

                    <!-- ======================================================== -->
                    <!-- SECTION 2: NETWORK ALARMS                                -->
                    <!-- ======================================================== -->
                    <div class="side-section-header">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <span>Network Alarms</span>
                    </div>

                    <a class="side-link @(currentController == "ManualEscalation" ? "active" : "")"
                       asp-controller="ManualEscalation"
                       asp-action="Index">
                        <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Manual Escalations
                    </a>
                    <a class="side-link @(currentController == "Alarm" ? "active" : "")"
                       asp-controller="Alarm"
                       asp-action="Index">
                        <i class="fa-solid fa-tower-broadcast me-1"></i> Alarms
                    </a>
                    <a class="side-link @(currentController == "FaultDockets" ? "active" : "")"
                       asp-controller="FaultDockets"
                       asp-action="Index">
                        <i class="fa-solid fa-folder-open me-1"></i> Fault-Dockets
                    </a>
                    <a class="side-link @(currentController == "Inbox" ? "active" : "")"
                       asp-controller="Inbox"
                       asp-action="Index">
                        <i class="fa-solid fa-inbox me-1"></i> Inbox
                    </a>
                    <a class="side-link @(currentController == "Views" ? "active" : "")"
                       asp-controller="Views"
                       asp-action="Index">
                        <i class="fa-solid fa-table-columns me-1"></i> Views
                    </a>
                    <a class="side-link @((currentController == "Home" && currentAction == "ApiTester") ? "active" : "")"
                       asp-controller="Home"
                       asp-action="ApiTester">
                        <i class="fa-solid fa-satellite me-1"></i> Starlink
                    </a>
                    <a class="side-link @(currentController == "Links" ? "active" : "")"
                       asp-controller="Links"
                       asp-action="Index">
                        <i class="fa-solid fa-link me-1"></i> Links
                    </a>
                    <a class="side-link @(currentController == "AlarmDelay" ? "active" : "")"
                       asp-controller="AlarmDelay"
                       asp-action="Index">
                        <i class="fa-solid fa-clock-rotate-left me-1"></i> Alarm Delays
                    </a>
                    <a class="side-link @(currentController == "TroubleTicket" ? "active" : "")"
                       asp-controller="TroubleTicket"
                       asp-action="Index">
                        <i class="fa-solid fa-ticket me-1"></i> Trouble Ticket
                    </a>
                    <a class="side-link @(currentController == "PowerAlarm" ? "active" : "")"
                       asp-controller="PowerAlarm"
                       asp-action="Index">
                        <i class="fa-solid fa-bolt me-1"></i> Power Alarm
                    </a>
                    <a class="side-link @(currentController == "RPBSummary" ? "active" : "")"
                       asp-controller="RPBSummary"
                       asp-action="Index">
                        <i class="fa-solid fa-chart-pie me-1"></i> RPB Summary
                    </a>

                    <!-- Submenu: Search -->
                    <div class="side-link-group">
                        <div class="side-link-row">
                            <a class="side-link side-link-parent @(isSearchArea ? "active" : "")"
                               href="javascript:void(0)"
                               data-menu-toggle="search-submenu">
                                <i class="fa-solid fa-magnifying-glass me-1"></i> Search
                            </a>
                            <button class="side-link-expander @(isSearchArea ? "expanded" : "")"
                                    type="button"
                                    data-menu-toggle="search-submenu"
                                    aria-controls="search-submenu"
                                    aria-expanded="@(isSearchArea.ToString().ToLowerInvariant())"
                                    title="Toggle Search menu">
                                <span aria-hidden="true">&#9660;</span>
                            </button>
                        </div>
                        <div id="search-submenu" class="side-submenu @(isSearchArea ? "open" : "")">
                            <a class="side-sublink @(currentController == "CircuitId" ? "active" : "")"
                               asp-controller="CircuitId"
                               asp-action="Index">
                                <i class="fa-solid fa-route me-1"></i> Search Circuit
                            </a>
                            <a class="side-sublink @(currentController == "SearchByNode" ? "active" : "")"
                               asp-controller="SearchByNode"
                               asp-action="Index">
                                <i class="fa-solid fa-network-wired me-1"></i> Search By Node Name
                            </a>
                        </div>
                    </div>

                    <!-- ======================================================== -->
                    <!-- SECTION 3: REPORTS                                       -->
                    <!-- ======================================================== -->
                    <div class="side-section-header">
                        <i class="fa-solid fa-chart-line"></i>
                        <span>Reports</span>
                    </div>

                    <!-- Submenu: SAT Reports -->
                    <div class="side-link-group">
                        <div class="side-link-row">
                            <a class="side-link side-link-parent @(isSatReportsArea ? "active" : "")"
                               href="javascript:void(0)"
                               data-menu-toggle="sat-reports-submenu">
                                <i class="fa-solid fa-envelope-open-text me-1"></i> SAT Reports
                            </a>
                            <button class="side-link-expander @(isSatReportsArea ? "expanded" : "")"
                                    type="button"
                                    data-menu-toggle="sat-reports-submenu"
                                    aria-controls="sat-reports-submenu"
                                    aria-expanded="@(isSatReportsArea.ToString().ToLowerInvariant())"
                                    title="Toggle SAT Reports">
                                <span aria-hidden="true">&#9660;</span>
                            </button>
                        </div>
                        <div id="sat-reports-submenu" class="side-submenu @(isSatReportsArea ? "open" : "")">
                            <a class="side-sublink" href="/DailyEmailReport/Preview?type=1" title="08:00 AM Daily Dispatch">
                                <i class="fa-solid fa-file-excel me-1"></i> Type 1: Regional Teams
                            </a>
                            <a class="side-sublink" href="/DailyEmailReport/Preview?type=2" title="07:00 AM Daily Dispatch">
                                <i class="fa-solid fa-file-excel me-1"></i> Type 2: OPMC Faults
                            </a>
                            <a class="side-sublink" href="/DailyEmailReport/Preview?type=3" title="00:15 Midnight Dispatch">
                                <i class="fa-solid fa-file-excel me-1"></i> Type 3: NOC Midnight
                            </a>
                            <a class="side-sublink" href="/DailyEmailReport/Preview?type=4" title="08:00 AM Network Failure Summary">
                                <i class="fa-solid fa-file-excel me-1"></i> Type 4: Network Summary
                            </a>
                        </div>
                    </div>

                    <a class="side-link @(currentController == "TodayNodeDown" ? "active" : "")"
                       asp-controller="TodayNodeDown"
                       asp-action="Index">
                        <i class="fa-solid fa-calendar-day me-1"></i> Today Node Down
                    </a>
                    <a class="side-link @(currentController == "SummaryCarrierFaults" ? "active" : "")"
                       asp-controller="SummaryCarrierFaults"
                       asp-action="Index">
                        <i class="fa-solid fa-briefcase me-1"></i> Summary Carrier Faults
                    </a>
                    <a class="side-link @(currentController == "SummaryNetworkFaults" ? "active" : "")"
                       asp-controller="SummaryNetworkFaults"
                       asp-action="Index">
                        <i class="fa-solid fa-diagram-project me-1"></i> Summary Network Faults
                    </a>
                    <a class="side-link @(currentController == "NodeDownReport" ? "active" : "")"
                       asp-controller="NodeDownReport"
                       asp-action="Index">
                        <i class="fa-solid fa-circle-down me-1"></i> Node Down
                    </a>
                    <a class="side-link @(currentController == "ACMainFailure" ? "active" : "")"
                       asp-controller="ACMainFailure"
                       asp-action="Index">
                        <i class="fa-solid fa-plug-circle-xmark me-1"></i> AC Mains Failure
                    </a>
                    <a class="side-link @(currentController == "AlarmHistoryEngineer" ? "active" : "")"
                       asp-controller="AlarmHistoryEngineer"
                       asp-action="Index">
                        <i class="fa-solid fa-user-gear me-1"></i> Alarm History Network Engineer
                    </a>
                    <a class="side-link @(currentController == "AlarmHistoryProvince" ? "active" : "")"
                       asp-controller="AlarmHistoryProvince"
                       asp-action="Index">
                        <i class="fa-solid fa-map-location-dot me-1"></i> Alarm History Provincewise
                    </a>
                    <a class="side-link @(currentController == "Summary" ? "active" : "")"
                       asp-controller="Summary"
                       asp-action="Index">
                        <i class="fa-solid fa-chart-column me-1"></i> Summary
                    </a>
                    <a class="side-link @((currentController == "Report" && currentAction == "NodeDownReport") ? "active" : "")"
                       asp-controller="Report"
                       asp-action="NodeDownReport">
                        <i class="fa-solid fa-ethernet me-1"></i> CEA Port Report
                    </a>

                    <!-- ======================================================== -->
                    <!-- SECTION 4: ADMIN DASHBOARD                               -->
                    <!-- ======================================================== -->
                    <div class="side-section-header">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Admin Dashboard</span>
                    </div>

                    <a class="side-link @(currentController == "Config" ? "active" : "")"
                       asp-controller="Config"
                       asp-action="Index">
                        <i class="fa-solid fa-gears me-1"></i> Config
                    </a>

                </nav>
            </aside>
        }

        <div class="app-content">
    <main class="container-fluid py-4 px-3">
    @RenderBody()
</main>

            <footer class="border-top bg-white">
                <div class="container py-3 d-flex justify-content-between align-items-center">
                    <span class="text-muted small">&copy; @DateTime.Now.Year - AlarmSystem</span>
                </div>
            </footer>
        </div>
    </div>

    @if (TempData["ToastMessage"] != null)
    {
        <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1200;">
            <div id="appToast" class="toast align-items-center text-bg-success border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body">
                        @TempData["ToastMessage"]
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto"
                            data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.appApiBase = '@Url.Content("~/api")';
        window.addEventListener('pageshow', function (event) {
            if (event.persisted || (window.performance && window.performance.navigation && window.performance.navigation.type === 2)) {
                window.location.reload();
            }
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @if (TempData["ToastMessage"] != null)
    {
        <script>
            const toastEl = document.getElementById('appToast');
            const t = new bootstrap.Toast(toastEl, { delay: 3000 });
            t.show();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


