@model AlarmSystem.ViewModels.OutageReasonViewModel

@{
    ViewData["Title"] = "Update Outage Reason";
}

<h2>UPDATE OUTAGE REASON</h2>

<form asp-action="Index" method="get">

    <div class="row mb-3">

        <div class="col-md-3">
            <label class="form-label">SELECT PLATFORM</label>

            <select asp-for="SelectedPlatform"
                    asp-items="Model.Platforms"
                    name="platform"
                    class="form-select"
                    onchange="this.form.submit()">
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">SELECT NW ENG</label>

            <select asp-for="SelectedNwEng"
                    asp-items="Model.NetworkEngineers"
                    name="nwEng"
                    class="form-select"
                    onchange="this.form.submit()">
            </select>
        </div>

    </div>

</form>

<table class="table table-bordered table-striped table-hover">

    <thead class="table-primary">

        <tr>
            <th>ID</th>
            <th>NODE</th>
            <th>PLATFORM</th>
            <th>FAULT TIME</th>
            <th>HOURS</th>
            <th>FAULT</th>
            <th>NW ENG</th>
            <th>TAG</th>
            <th></th>
        </tr>

    </thead>

    <tbody>

@foreach (var item in Model.Alarms)
{
        <tr>

            <td>@item.ID</td>

           <td>
    <a asp-controller="AlarmDetails"
       asp-action="Details"
       asp-route-id="@item.ID">
        @item.NODE
    </a>
</td>

            <td>@item.PLATFORM</td>

            <td>@item.FAULT_TIME.ToString("g")</td>

            <td>@item.HOURS</td>

            <td>@item.FAULT</td>

            <td>@item.NW_ENG</td>

            <td>@item.TAG</td>

            <td>
                <a asp-action="Edit"
                   asp-route-id="@item.ID"
                   class="btn btn-primary btn-sm">
                    Edit
                </a>
            </td>

        </tr>
}

    </tbody>

</table>

<div class="mt-3 text-danger">
    Shows Alarms upto 4 days
</div>