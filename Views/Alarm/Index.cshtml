@model List<AlarmSystem.Models.Alarm.AlarmModel>

@{
    ViewData["Title"] = "Alarm Monitoring";

    var totalAlarms = Model.Count;
    var platformCount = Model.Select(x => x.PLATFORM).Distinct().Count();
    var majorCount = Model.Count(x => x.HOURS > 4 && x.HOURS <= 15);
    var criticalCount = Model.Count(x => x.HOURS > 15);
}

@section Styles{
    <link rel="stylesheet"
          href="~/css/alarm.css"
          asp-append-version="true" />
}

<div class="alarm-page">

    <!-- HERO -->

    <div class="alarm-hero">

        <div class="hero-overlay"></div>

        <div class="hero-content">

            <div class="hero-left">

                <div class="hero-icon">

                    <i class="fas fa-broadcast-tower"></i>

                </div>

                <div>

                    <h1>Alarm Monitoring</h1>

                    <p>

                        Real-time Network Alarm Dashboard

                    </p>

                </div>

            </div>

            <div class="hero-search">

                <i class="fas fa-search"></i>

                <input id="searchInput"
                       type="text"
                       placeholder="Search Node / Platform / Alarm..." />

            </div>

        </div>

    </div>

    <!-- SUMMARY -->

    <div class="summary-grid">

        <div class="summary-card blue">

            <div class="summary-icon">

                <i class="fas fa-satellite-dish"></i>

            </div>

            <div>

                <h2>@totalAlarms</h2>

                <span>Total Alarms</span>

            </div>

        </div>

        <div class="summary-card red">

            <div class="summary-icon">

                <i class="fas fa-fire"></i>

            </div>

            <div>

                <h2>@criticalCount</h2>

                <span>Critical</span>

            </div>

        </div>

        <div class="summary-card orange">

            <div class="summary-icon">

                <i class="fas fa-exclamation-circle"></i>

            </div>

            <div>

                <h2>@majorCount</h2>

                <span>Major</span>

            </div>

        </div>

        <div class="summary-card green">

            <div class="summary-icon">

                <i class="fas fa-network-wired"></i>

            </div>

            <div>

                <h2>@platformCount</h2>

                <span>Platforms</span>

            </div>

        </div>

    </div>

    <!-- FILTER PANEL -->

    <div class="filter-panel">

        <form asp-action="Index" method="get">

            <div class="filter-grid">

                <div class="filter-box">

                    <label>Select Platform</label>

                    <select name="platform"
                            class="form-select"
                            onchange="this.form.submit()">

                        @foreach (string p in ViewBag.Platforms)
                        {
                            if (p == ViewBag.Platform)
                            {
                                <option selected value="@p">@p</option>
                            }
                            else
                            {
                                <option value="@p">@p</option>
                            }
                        }

                    </select>

                </div>

                <div class="filter-box">

                    <label>Select Alarm Type</label>

                    <select name="alarmType"
                            class="form-select"
                            onchange="this.form.submit()">

                        @foreach (string a in ViewBag.AlarmTypes)
                        {
                            if (a == ViewBag.AlarmType)
                            {
                                <option selected value="@a">@a</option>
                            }
                            else
                            {
                                <option value="@a">@a</option>
                            }
                        }

                    </select>

                </div>

                <div class="filter-box">

                    <label>Select NW Engineer</label>

                    <select name="nwEng"
                            class="form-select"
                            onchange="this.form.submit()">

                        @foreach (string n in ViewBag.NetworkEngineers)
                        {
                            if (n == ViewBag.NwEng)
                            {
                                <option selected value="@n">@n</option>
                            }
                            else
                            {
                                <option value="@n">@n</option>
                            }
                        }

                    </select>

                </div>

            </div>

        </form>

    </div>

    <div class="current-platform">

        Platform :

        <span>@ViewBag.Platform</span>

    </div>

    <!-- TABLE CONTINUES IN PART 2 -->

        <!-- ALARM TABLE -->

    <div class="table-card">

      <div class="table-header d-flex justify-content-between align-items-center">

    <div>

        <h3>Active Alarm List</h3>

        <p>Real-time network alarms</p>

    </div>

    <a asp-action="ExportToExcel"
       asp-route-platform="@ViewBag.Platform"
       asp-route-alarmType="@ViewBag.AlarmType"
       asp-route-nwEng="@ViewBag.NwEng"
       class="btn btn-success">

        <i class="fas fa-file-excel"></i>

        Export to Excel

    </a>

</div>

        <div class="table-responsive">

            <table class="table premium-table">

                <thead>

                    <tr>

                        <th>ID</th>
                        <th>NODE</th>
                        <th>PLATFORM</th>
                        <th>FAULT</th>
                        <th>ALARM TYPE</th>
                        <th>FAULT TIME</th>
                        <th>HOURS</th>
                        <th>NW ENGINEER</th>

                    </tr>

                </thead>

                <tbody id="alarmTable">

@foreach (var item in Model)
{
    var badgeClass = "success";
    var badgeText = "Normal";

    if (item.HOURS <= 4)
    {
        badgeClass = "success";
        badgeText = "Low";
    }
    else if (item.HOURS <= 15)
    {
        badgeClass = "warning";
        badgeText = "Medium";
    }
    else
    {
        badgeClass = "danger";
        badgeText = "Critical";
    }

<tr>

    <td>@item.ID</td>

    <td>

        <a asp-controller="Alarm"
           asp-action="Details"
           asp-route-id="@item.ID">

            @item.NODE

        </a>

    </td>

    <td>

        @item.PLATFORM

    </td>

<td class="fault-column">

    @item.FAULT

</td>

    <td>

        @item.ALARM_TYPE

    </td>

    <td>

        @item.FAULT_TIME

    </td>

    <td>

        <span class="badge bg-@badgeClass">

            @item.HOURS h

        </span>

    </td>

    <td>

        @item.NW_ENG

    </td>

</tr>

}

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts{

<script>

document.addEventListener("DOMContentLoaded", function(){

    const input = document.getElementById("searchInput");

    if(!input) return;

    input.addEventListener("keyup", function(){

        const value = this.value.toLowerCase();

        document.querySelectorAll("#alarmTable tr").forEach(function(row){

            row.style.display =
                row.innerText.toLowerCase().includes(value)
                    ? ""
                    : "none";

        });

    });

});

</script>

}