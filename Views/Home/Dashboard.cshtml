        function refreshRegionProvinceOptions(forceToken = "") {
            if (regionProvinceOptionsLoaded && !forceToken) {
                return Promise.resolve();
            }

            if (regionProvinceOptionsPromise) {
                return regionProvinceOptionsPromise;
            }

            const optionsUrl = buildRegionProvinceOptionsUrl(forceToken);
            regionProvinceOptionsPromise = fetch(optionsUrl, {
                cache: "no-store",
                headers: { "Accept": "application/json" }
            }).then(async response => {
                if (!response.ok) return;
                const optionRows = await response.json();
                if (!Array.isArray(optionRows)) return;

                regionProvincePairs = buildRegionProvincePairs(optionRows);
                syncRegionProvinceFilters();
                regionProvinceOptionsLoaded = true;
            }).catch(() => {
                // Ignore options refresh errors; map rendering should not be blocked by this helper dataset.
            }).finally(() => {
                regionProvinceOptionsPromise = null;
            });

            return regionProvinceOptionsPromise;
        }

        function normalizeCarrierCountsPayload(payload) {
            const counts = getEmptyCarrierCounts();
            if (!payload || typeof payload !== "object") return counts;

            for (const key of Object.keys(counts)) {
                const value = payload[key] ?? payload[key.toLowerCase()] ?? null;
                if (typeof value === "number") {
                    counts[key].alarmCount = Number.isFinite(value) ? value : 0;
                    counts[key].customerFaultCount = 0;
                    continue;
                }

                if (value && typeof value === "object") {
                    const alarm = Number(value.alarmCount ?? value.AlarmCount ?? 0);
                    const customer = Number(value.customerFaultCount ?? value.CustomerFaultCount ?? 0);
                    counts[key].alarmCount = Number.isFinite(alarm) ? alarm : 0;
                    counts[key].customerFaultCount = Number.isFinite(customer) ? customer : 0;
                }
            }

            return counts;
        }

        async function loadCustomerFaultCounts() {
