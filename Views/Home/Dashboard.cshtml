        async function loadNetworkFaultCounts() {
            // In customer fault mode, we need to count network faults only for nodes with customer faults
            // This requires fetching all network faults and filtering by node
            
            // Get unique nodes from displayed customer faults
            const customerFaultNodesByCarrier = {};
            Object.keys(carrierInfo).forEach(key => {
                customerFaultNodesByCarrier[key] = new Set();
            });
            
            lastDisplayedFaultRows.forEach(entry => {
                const carrier = entry._resolvedCarrier;
                const row = entry._row;
                const node = readField(row, "nodeName", "NodeName", "NW_NODE", "nw_node", "EQ_LOCATION_NODE", "eq_LOCATION_NODE", "node", "NODE");
                if (node && node.trim() !== "" && carrier) {
                    customerFaultNodesByCarrier[carrier].add(node.toLowerCase());
                }
            });
            
            console.log("[DEBUG] Customer fault nodes by carrier:", customerFaultNodesByCarrier);
            
            // Fetch network faults for each carrier and count only those matching customer fault nodes
            const from = document.getElementById("filterFrom").value;
            const to = document.getElementById("filterTo").value;
            const region = document.getElementById("filterRegion")?.value?.trim() ?? "";
            const province = document.getElementById("filterProvince")?.value?.trim() ?? "";
            const top = document.getElementById("filterTop").value;
            
            for (const carrierKey of Object.keys(carrierInfo)) {
                const nodesForCarrier = customerFaultNodesByCarrier[carrierKey];
                if (nodesForCarrier.size === 0) {
                    carrierAlarmCounts[carrierKey].alarmCount = 0;
                    continue;
                }
                
                const params = new URLSearchParams();
                if (from) params.set("from", from);
                if (to) params.set("to", to);
                if (region) params.set("region", region);
                if (province) params.set("province", province);
                if (top) params.set("top", top);
                params.set("carrier", carrierKey);
                
                const baseUrl = '@Url.Content("~/api/map/faults")';
                try {
                    const res = await fetch(`${baseUrl}?${params.toString()}`, { cache: "no-store", headers: { "Accept": "application/json" } });
                    if (!res.ok) continue;
                    const rows = await res.json();
                    
                    // Count only network faults for nodes that have customer faults
                    let count = 0;
                    if (Array.isArray(rows)) {
                        rows.forEach(row => {
                            const nwNode = readField(row, "nodeName", "NodeName", "NODE", "node", "EQ_LOCATION_NODE", "eq_LOCATION_NODE");
                            if (nwNode && nodesForCarrier.has(nwNode.toLowerCase())) {
                                count++;
                            }
                        });
                    }
                    
                    carrierAlarmCounts[carrierKey].alarmCount = count;
                    console.log(`[DEBUG] Network fault count for ${carrierKey}:`, count);
                } catch (err) {
                    console.error(`Failed to load network fault count for ${carrierKey}:`, err);
                    carrierAlarmCounts[carrierKey].alarmCount = 0;
                }
            }
            
            renderCarrierLegend(carrierAlarmCounts);
        }

