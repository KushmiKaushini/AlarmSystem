        function handleCarrierCountClick(carrierKey, type) {

    const customerMode = isCustomerFaultMode();
    const allCustomerMode = document.getElementById("filterAllCustomerFault")?.checked === true;

    // ✅ treat BOTH as customer modes
    if (customerMode || allCustomerMode) {

        if (type === "C") {
            openCarrierFaultModal(carrierKey);   // ✅ show customer faults
        } else {
            openNwFaultModalForCarrier(carrierKey); // optional: NW faults
        }

    } else {
        // ✅ normal network mode
        if (type === "N") {
            openNwFaultModalForCarrier(carrierKey);
        } else {
            openCustomerFaultModalForCarrier(carrierKey);
        }
    }
}


        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById("carrierLegend")?.addEventListener("click", (e) => {
                const countSpan = e.target.closest("[data-type][data-carrier]");
                if (countSpan) {
                    e.stopPropagation();
                    handleCarrierCountClick(countSpan.dataset.carrier, countSpan.dataset.type);
                    return;
                }
                const pill = e.target.closest(".carrier-pill[data-carrier]");
                if (pill) openCarrierFaultModal(pill.dataset.carrier);
            });
            document.getElementById("carrierLegend")?.addEventListener("keydown", (e) => {
                if (e.key !== "Enter" && e.key !== " ") return;
                const pill = e.target.closest(".carrier-pill[data-carrier]");
                if (pill) { e.preventDefault(); openCarrierFaultModal(pill.dataset.carrier); }
            });
        });
