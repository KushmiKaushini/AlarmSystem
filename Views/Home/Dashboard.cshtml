        function initMap() {
            const mapDiv = document.getElementById("map");
            if (!mapDiv) return; // ✅ prevents "mapDiv null" if accidentally loaded elsewhere

            map = new google.maps.Map(mapDiv, {
                center: { lat: 7.8731, lng: 80.7718 },
                zoom: 8,
                mapTypeControl: true,
                streetViewControl: false,
                fullscreenControl: true
            });

            bounds = new google.maps.LatLngBounds();
            infoWindow = new google.maps.InfoWindow();

            // Start with no date constraints so the map shows all available network-fault data by default.
            document.getElementById("filterFrom").value = "";
            document.getElementById("filterTo").value = "";

            const customerFaultEl = document.getElementById("filterCustomerFault");
            const allCustomerFaultEl = document.getElementById("filterAllCustomerFault");
            
            if (customerFaultEl) {
                customerFaultEl.checked = false;
                appliedCustomerFaultMode = false;
                updateCustomerFaultFilterUi();

                customerFaultEl.addEventListener("change", () => {

        if (customerFaultEl.checked) {
                            document.getElementById("filterAllCustomerFault").checked = false;
        }

                    appliedCustomerFaultMode = customerFaultEl.checked;
                    updateCustomerFaultFilterUi();
                    document.getElementById("mapStatus").textContent = customerFaultEl.checked
                        ? "Customer Fault mode selected. Loading filtered customer faults..."
                        : "Customer Fault mode cleared. Loading all network faults...";
                    loadFaults();
                });
            }


        if (allCustomerFaultEl) {
            allCustomerFaultEl.addEventListener("change", () => {

                // ✅ prevent both checkboxes active at same time
                if (allCustomerFaultEl.checked) {
                    document.getElementById("filterCustomerFault").checked = false;
                }

                appliedCustomerFaultMode = false;

                loadFaults();
            });
        }


            document.getElementById("btnApply").addEventListener("click", (event) => {
                event.preventDefault();
                appliedCustomerFaultMode = getCustomerFaultToggleValue();
                updateCustomerFaultFilterUi();
                loadFaults();
            });
            document.getElementById("btnRefresh").addEventListener("click", (event) => {
                event.preventDefault();
                appliedCustomerFaultMode = getCustomerFaultToggleValue();
                updateCustomerFaultFilterUi();
                document.getElementById("mapStatus").textContent = "Refreshing faults...";
                loadFaults(Date.now().toString());
            });
            document.getElementById("filterCarrier").addEventListener("change", () => renderCarrierLegend(carrierAlarmCounts));
            document.getElementById("filterRegion")?.addEventListener("change", () => {
                syncRegionProvinceFilters(true);
                loadFaults();
            });
            document.getElementById("filterProvince")?.addEventListener("change", loadFaults);

            syncRegionProvinceFilters();
            updateCustomerFaultFilterUi();
            renderCarrierLegend(carrierAlarmCounts);
            loadFaults();
        }

