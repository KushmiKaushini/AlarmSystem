        function showCarrierMessage(carrierKey, message) {
            const info = carrierInfo[carrierKey];
            const titleEl = document.getElementById("carrierFaultModalTitle");
            const bodyEl = document.getElementById("carrierFaultModalBody");
            if (!titleEl || !bodyEl) return;
            titleEl.textContent = info ? info.name : carrierKey;
            bodyEl.innerHTML = `<p class="text-muted">${escapeHtml(message)}</p>`;
            const modalEl = document.getElementById("carrierFaultModal");
            if (modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).show();
        }

        async function openNwFaultModalForCarrier(carrierKey) {
            const info = carrierInfo[carrierKey];
            const titleEl = document.getElementById("carrierFaultModalTitle");
            const bodyEl = document.getElementById("carrierFaultModalBody");
            if (!titleEl || !bodyEl) return;

            titleEl.textContent = `${info?.name ?? carrierKey} Network Faults`;
            bodyEl.innerHTML = `<p class="text-muted">Loading...</p>`;
            const modalEl = document.getElementById("carrierFaultModal");
            if (modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).show();

            const from = document.getElementById("filterFrom").value;
            const to = document.getElementById("filterTo").value;
            const region = document.getElementById("filterRegion")?.value?.trim() ?? "";
            const province = document.getElementById("filterProvince")?.value?.trim() ?? "";
            const top = document.getElementById("filterTop").value;

            const params = new URLSearchParams();
            if (from) params.set("from", from);
            if (to) params.set("to", to);
            if (region) params.set("region", region);
            if (province) params.set("province", province);
            if (top) params.set("top", top);
            params.set("carrier", carrierKey);

            const baseUrl = '@Url.Content("~/api/map/faults_all")';
            try {
                const res = await fetch(`${baseUrl}?${params.toString()}`, { cache: "no-store", headers: { "Accept": "application/json" } });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                let rows = await res.json();
                
                // If in customer fault mode, filter network faults to only show those for nodes with customer faults
                if (isCustomerFaultMode()) {
                    // Get the list of nodes that have customer faults for this carrier
                    const customerFaultNodes = lastDisplayedFaultRows
                        .filter(entry => entry._resolvedCarrier === carrierKey)
                        .map(entry => {
                            const row = entry._row;
                            // Get node name from customer fault data
                            return readField(row, "nodeName", "NodeName", "NW_NODE", "nw_node", "EQ_LOCATION_NODE", "eq_LOCATION_NODE", "node", "NODE");
                        })
                        .filter(node => node && node.trim() !== "");
                    
                    console.log("[DEBUG] Customer fault nodes for", carrierKey, ":", customerFaultNodes);
                    
                    // Filter network faults to only include those with matching nodes
                    if (Array.isArray(rows) && customerFaultNodes.length > 0) {
                        rows = rows.filter(row => {
                            const nwNode = readField(row, "nodeName", "NodeName", "NODE", "node", "EQ_LOCATION_NODE", "eq_LOCATION_NODE");
                            const match = customerFaultNodes.some(cfNode => 
                                cfNode.toLowerCase() === (nwNode || "").toLowerCase()
                            );
                            console.log("[DEBUG] NW fault node:", nwNode, "matches customer fault node:", match);
                            return match;
                        });
                    } else {
                        rows = [];
                    }
                }
                
                if (!Array.isArray(rows) || rows.length === 0) {
                    const message = isCustomerFaultMode() 
                        ? `No network faults found for nodes with customer faults for ${escapeHtml(info?.name ?? carrierKey)}.`
                        : `No network faults found for ${escapeHtml(info?.name ?? carrierKey)}.`;
                    bodyEl.innerHTML = `<p class="text-muted">${message}</p>`;
                    return;
                }
                titleEl.textContent = `${info?.name ?? carrierKey} Network Faults (${rows.length})`;
                bodyEl.innerHTML = `
                    <table class="table align-middle mb-0 viewdata-table">
                        <thead><tr>
                            <th>Node</th><th style="min-width:300px">Fault</th><th>Fault Time</th><th>Region</th>
                            <th>Province</th><th>NW Eng</th><th>Alarm Type</th><th>Source IP</th>
                            <th>CCT ID</th><th>Alias Name</th>
                        </tr></thead>
                        <tbody>
                            ${rows.map(row => {
                                const node = escapeHtml(readField(row, "nodeName", "NodeName", "NODE", "node", "EQ_LOCATION_NODE", "eq_LOCATION_NODE") || "—");
                                const fault = escapeHtml(sanitizeFaultDetailsText(readField(row, "fault", "FAULT")) || "—");
                                const faultTime = escapeHtml(readField(row, "faultTime", "FAULT_TIME", "fault_TIME") || "—");
                                const region = escapeHtml(readField(row, "REGION", "region", "Region") || "—");
                                const province = escapeHtml(readField(row, "PROVINCE", "province", "Province") || "—");
                                const nwEng = escapeHtml(readField(row, "NW_ENG", "nw_eng", "NwEng", "R_GM", "r_gm") || "—");
                                const alarmType = escapeHtml(readField(row, "ALARM_TYPE", "alarm_type", "AlarmType", "faultType", "FaultType") || "—");
                                const sourceIp = escapeHtml(readField(row, "sourceip", "SOURCEIP", "SourceIp", "IP_ADDRESS", "ip_address") || "—");
                                const cctId = escapeHtml(readField(row, "CCTID", "cctid", "CctId", "CCT", "cct") || "—");
                                const aliasName = escapeHtml(readField(row, "Alias_Name", "ALIAS_NAME", "alias_name", "AliasName", "CIRCUIT_NAME", "circuit_name") || "—");
                                return `<tr>
                                    <td><small style="color:#0f172a">${node}</small></td>
                                    <td style="min-width:300px;white-space:normal;word-wrap:break-word"><small style="color:#0f172a">${fault}</small></td>
                                    <td style="white-space:nowrap"><small style="color:#0f172a">${faultTime}</small></td>
                                    <td><small style="color:#0f172a">${region}</small></td>
                                    <td><small style="color:#0f172a">${province}</small></td>
                                    <td><small style="color:#0f172a">${nwEng}</small></td>
                                    <td><small style="color:#0f172a">${alarmType}</small></td>
                                    <td><small style="color:#0f172a;font-family:monospace">${sourceIp}</small></td>
                                    <td><small style="color:#0f172a;font-family:monospace">${cctId}</small></td>
                                    <td><small style="color:#0f172a">${aliasName}</small></td>
                                </tr>`;
                            }).join("")}
                        </tbody>
                    </table>`;
            } catch (err) {
                bodyEl.innerHTML = `<p class="text-danger">Failed to load network faults: ${escapeHtml(err.message)}</p>`;
            }
        }

