@{
    ViewData["Title"] = "Dashboard";
    var dashboardType = ViewData["DashboardType"]?.ToString() ?? "Admin";
    var isViewerDashboard = string.Equals(dashboardType, "Viewer", StringComparison.OrdinalIgnoreCase);
}

<div class="dashboard-canvas">
    <div class="map-shell">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="text-white mb-0">Fault Locations Map</h3>
            <div class="d-flex align-items-center gap-3 dashboard-header-tools">
                <div class="form-check customer-fault-check m-0">
                    <input id="filterCustomerFault" type="checkbox" class="form-check-input" value="1" />
                    <label class="form-check-label mb-0" for="filterCustomerFault">Customer Fault</label>
                </div>
                
<div class="form-check customer-fault-check m-0">
    <input id="filterAllCustomerFault" type="checkbox" class="form-check-input" />
    <label class="form-check-label mb-0" for="filterAllCustomerFault">
        All Customer Faults
    </label>
</div>

                @if (!isViewerDashboard)
                {
                    <span class="badge bg-primary-subtle text-primary-emphasis">Admin</span>
                }
                else
                {
                    <span class="badge bg-info-subtle text-info-emphasis">Viewer</span>
                }
            </div>
        </div>

        <div class="dashboard-content-layout">
            <aside class="dashboard-filter-panel">
                <div class="dashboard-filter-grid">
                    <div class="dashboard-filter-item">
                        <label class="form-label text-white-50 small mb-1">From</label>
                        <input id="filterFrom" type="date" class="form-control" />
                    </div>

                    <div class="dashboard-filter-item">
                        <label class="form-label text-white-50 small mb-1">To</label>
                        <input id="filterTo" type="date" class="form-control" />
                    </div>

                    <div class="dashboard-filter-item">
                        <label class="form-label text-white-50 small mb-1">Carrier</label>
                        <select id="filterCarrier" class="form-select">
                            <option value="">All</option>
                            <option value="Dialog">Dialog</option>
                            
                            <option value="Mobitel">Mobitel</option>
                            <option value="Hutch">Hutch</option>
                            <option value="Etisalat">Etisalat</option>
                            <option value="Airtel">Airtel</option>
                        </select>
                    </div>

                    <div class="dashboard-filter-item">
                        <label class="form-label text-white-50 small mb-1">Top</label>
                        <input id="filterTop" type="number" class="form-control" value="100" min="100" max="10000" />
                    </div>

                    <div class="dashboard-filter-item dashboard-filter-item-full">
                        <label class="form-label text-white-50 small mb-1">Search (CCT / Node / fault text)</label>
                        <input id="filterSearch" class="form-control" placeholder="ex: D94766, LOS, Colombo" />
                    </div>

                    <div class="region-province-filters dashboard-filter-item-full">
                        <div class="region-province-item">
                            <label class="form-label text-white-50 small mb-1" for="filterRegion">Region</label>
                            <select id="filterRegion" class="form-select">
                                <option value="">All regions</option>
                            </select>
                        </div>

                        <div class="region-province-item">
                            <label class="form-label text-white-50 small mb-1" for="filterProvince">Province</label>
                            <select id="filterProvince" class="form-select">
                                <option value="">All provinces</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="dashboard-filter-actions">
                    <button id="btnApply" type="button" class="btn btn-light">View</button>
                    <button id="btnRefresh" type="button" class="btn btn-outline-light">Refresh</button>
                </div>

                <div class="dashboard-filter-summary">
                    <div class="dashboard-filter-summary-title">Carrier alarm counts</div>
                    <div id="carrierLegend" class="carrier-legend d-none" aria-live="polite"></div>
                </div>
            </aside>

            <section class="dashboard-map-panel">
                <div id="mapStatus" class="text-white small mb-2">Loading faults...</div>
                <div id="map"></div>
            </section>
        </div>
    </div>

</div>

<div class="modal fade" id="carrierFaultModal" tabindex="-1" aria-labelledby="carrierFaultModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen-xxl-down modal-dialog-centered modal-dialog-scrollable viewdata-detail-dialog">
        <div class="modal-content viewdata-detail-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="carrierFaultModalTitle">Carrier Faults</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="overflow-x:auto;color:#0f172a">
                <div id="carrierFaultModalBody"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let map, infoWindow, bounds;
        let markers = [];
        let lines = [];

        // ✅ Carrier colors (brand aligned palette)
        const carrierColors = {
            "Dialog": "#ffd400",      // bright yellow primary
            
            "Mobitel": "#0057b8",     // SLT-Mobitel blue
            "Hutch": "#002b5c",       // Hutch deep blue
            "Etisalat": "#2bb673",    // legacy Etisalat green
            "Airtel": "#f9a8d4"       // Airtel light pink
        };

        const UNKNOWN_CARRIER_COLOR = "#a5b4fc";

        const carrierInfo = {
            "Dialog": { name: "Dialog", desc: "Energetic bright yellow", color: carrierColors.Dialog },
            
            "Mobitel": { name: "SLT-Mobitel", desc: "Trustworthy blue", color: carrierColors.Mobitel },
            "Hutch": { name: "Hutch", desc: "Deep blue corporate", color: carrierColors.Hutch },
            "Etisalat": { name: "Etisalat", desc: "Fresh tech green", color: "#f97316" },
            "Airtel": { name: "Airtel", desc: "Vivid magenta presence", color: carrierColors.Airtel }
        };

        function getEmptyCarrierCounts() {
            const counts = {};
            Object.keys(carrierInfo).forEach(key => {
                counts[key] = {
                    alarmCount: 0,
                    customerFaultCount: 0
                };
            });
            return counts;
        }

        let carrierAlarmCounts = getEmptyCarrierCounts();
        let lastLoadedFaultRows = [];
        let lastDisplayedFaultRows = []; // rows that actually produced map markers (passed all skip checks)
        let regionProvincePairs = [];
        let appliedCustomerFaultMode = false;
        let regionProvinceOptionsLoaded = false;
        let regionProvinceOptionsPromise = null;
        let loadFaultsRequestId = 0;

        function normalizeCarrierLabel(value) {
            return String(value ?? "")
                .trim()
                .toLowerCase()
                .replace(/[\s_-]+/g, "")
                .replace(/[^a-z0-9]/g, "");
        }

        function resolveCarrierKey(row) {
            const rawCarrier = readField(row, "carrier", "Carrier", "customer_name", "CUSTOMER_NAME");
            const c = normalizeCarrierLabel(rawCarrier);

            if (c.includes("dialog")) return "Dialog";
            if (c.includes("sltmobitel") || c.includes("mobitel") || c === "slt" || c.includes("srilankatelecom") || c.includes("telecommobitel")) return "Mobitel";
            if (c.includes("hutch")) return "Hutch";
            if (c.includes("etisalat")) return "Etisalat";
            if (c.includes("airtel")) return "Airtel";

            const faultText = normalizeCarrierLabel(readField(row, "fault", "FAULT"));
            if (faultText.includes("dialog")) return "Dialog";
            if (faultText.includes("sltmobitel") || faultText.includes("mobitel") || faultText.includes("srilankatelecom") || faultText.includes("telecommobitel")) return "Mobitel";
            if (faultText.includes("hutch")) return "Hutch";
            if (faultText.includes("etisalat")) return "Etisalat";
            if (faultText.includes("airtel")) return "Airtel";

            const nodeName = normalizeCarrierLabel(readField(row, "nodeName", "NodeName", "node", "NODE", "EQ_LOCATION_NODE", "eq_LOCATION_NODE"));
            if (nodeName.includes("dialog")) return "Dialog";
            if (nodeName.includes("sltmobitel") || nodeName.includes("mobitel") || nodeName.includes("srilankatelecom")) return "Mobitel";
            if (nodeName.includes("hutch")) return "Hutch";
            if (nodeName.includes("etisalat")) return "Etisalat";
            if (nodeName.includes("airtel")) return "Airtel";


            //const Alarm_Time = readField(x,"Alarm_Time", "alarmTime", "Alarm_time", "FAULT_TIME");
            //const AlarmDes= readField(x,"AlarmDes", "alarm", "Alarm", "FAULT");


            return "";
        }

        const carrierLogos = {
            "Dialog": "🟡",
            "Mobitel": "🔵",
            "Hutch": "🔷",
            "Etisalat": "🟠",
            "Airtel": "🟣"
        };

        const HIGHLIGHT_COLOR = "#ff0000";
        const CEA_NORMAL_COLOR = "#10b981";
        const CUSTOMER_FAULT_DOT_COLOR = "#dc2626";

        function getCustomerFaultToggleValue() {
            return document.getElementById("filterCustomerFault")?.checked === true;
        }

        function isCustomerFaultMode() {
            return appliedCustomerFaultMode === true;
        }

        function updateCustomerFaultFilterUi() {
            const regionEl = document.getElementById("filterRegion");
            const provinceEl = document.getElementById("filterProvince");
            const wrapper = document.querySelector(".region-province-filters");
            const customerMode = isCustomerFaultMode();

            if (regionEl) regionEl.disabled = false;
            if (provinceEl) provinceEl.disabled = false;

            if (!wrapper) return;

            wrapper.style.opacity = "1";
            wrapper.style.pointerEvents = "auto";
            wrapper.title = customerMode
                ? "Customer fault mode uses region/province from matched NW faults."
                : "";
        }

        function formatLocationPoint(lat, lng) {
            const latNum = Number(lat);
            const lngNum = Number(lng);
            if (!Number.isFinite(latNum) || !Number.isFinite(lngNum)) return "—";
            return `Lat ${latNum.toFixed(5)}, Lng ${lngNum.toFixed(5)}`;
        }

        function escapeHtml(str) {
            return String(str ?? '').replace(/[&<>"']/g, s => ({
                "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"
            }[s]));
        }

        function normalizeKey(key) {
            return String(key ?? "").replace(/[^a-z0-9]/gi, "").toLowerCase();
        }

        function readField(obj, ...keys) {
            if (!obj || keys.length === 0) return "";

            for (const key of keys) {
                if (Object.prototype.hasOwnProperty.call(obj, key)) {
                    const value = obj[key];
                    if (value !== null && value !== undefined && String(value).trim() !== "") return String(value);
                }
            }

            const normalized = Object.entries(obj).map(([k, v]) => [normalizeKey(k), v]);
            for (const key of keys) {
                const wanted = normalizeKey(key);
                const found = normalized.find(([k]) => k === wanted);
                if (!found) continue;
                const value = found[1];
                if (value !== null && value !== undefined && String(value).trim() !== "") return String(value);
            }

            return "";
        }

        function normalizeText(value) {
            return String(value ?? "").trim();
        }
        function getSafeValue(value, fallback = "Not Found") {

    if (value === null || value === undefined) return fallback;

    if (typeof value === "object") {

        if (value.value) return String(value.value).trim();
        if (value.name) return String(value.name).trim();
        if (value.text) return String(value.text).trim();

        const firstKey = Object.keys(value)[0];
        if (firstKey && value[firstKey] != null) {
            return String(value[firstKey]).trim();
        }

        return fallback;
    }

    const text = String(value).trim();
    return text !== "" ? text : fallback;
}

   function withFallback(value, fallback = "Not Found") {

    // ✅ Handle null / undefined
    if (value === null || value === undefined || value === "") return fallback;

    // ✅ Handle object safely
    if (typeof value === "object") {

        // Handle known object patterns
        if (value.value) return String(value.value).trim();
        if (value.name) return String(value.name).trim();
        if (value.text) return String(value.text).trim();

        // ✅ Empty object case (your scenario)
        if (Object.keys(value).length === 0) {
            return fallback;
        }

        // Unknown object → fallback
        return fallback;
    }

    // ✅ Normal string/number
    const text = String(value).trim();
    return text !== "" ? text : fallback;

}

        function sanitizeFaultDetailsText(value) {
            let text = String(value ?? "");
            if (!text) return "";

            text = text.replace(/\s+/g, " ").trim();

            // Remove only the requested span: from "## If Memo=-- :" up to and including ": Minor :".
            text = text.replace(/##\s*If\s*Memo\s*=\s*--\s*:[\s\S]*?\s*:\s*Minor\s*:/i, "## ");

            // Fallback for payloads that omit "##" wrappers around If Memo.
            text = text.replace(/\bIf\s*Memo\s*=\s*--\s*:[\s\S]*?\s*:\s*Minor\s*:/i, "");

            return text
                .replace(/\s{2,}/g, " ")
                .trim();
        }

        function parseCustomerFaultIdentifiers(value) {
            const text = String(value ?? "").replace(/\s+/g, " ").trim();
            if (!text) {
                return { cct: "", cr: "" };
            }

            const aliasMatch = text.match(/(?:^|\b)If\s+Alias\s*=\s*##\s*([^#]+?)\s*##/i)
                || text.match(/(?:^|\b)Alias\s*=\s*##\s*([^#]+?)\s*##/i);
            const canonical = aliasMatch ? aliasMatch[1].trim() : "";
            const shortCode = canonical ? canonical.split(/[_\s]/, 1)[0].trim() : "";

            return {
                cct: shortCode,
                cr: ""
            };
        }

        function displayText(value, fallback = "Not available") {
            const text = normalizeText(value);
            return text || fallback;
        }

        function buildPopupDetailRow(label, value, mono = false) {
            const raw = normalizeText(value);
            const resolved = raw || "Not available";
            const mutedClass = raw ? "" : " value-muted";
            const monoClass = mono ? " mono" : "";

            return `<div class="info-kv"><span class="k">${escapeHtml(label)}</span><span class="v${monoClass}${mutedClass}">${escapeHtml(resolved)}</span></div>`;
        }

            function buildEqNodeDisplay(nodeValue, ipValue) {
                const nodeText = normalizeText(nodeValue);
                const ipText = normalizeText(ipValue);

                if (ipText && nodeText) return `IP Address: ${ipText} | EQ Node: ${nodeText}`;
                if (ipText) return `IP Address: ${ipText}`;
                if (nodeText) return `EQ Node: ${nodeText}`;
                return "";
            }

        function getRegionValue(row) {
            return normalizeText(readField(row, "region","Region", "REGION", "region_name", "REGION_NAME"));
        }

        function getProvinceValue(row) {
            return normalizeText(readField(row, "province","Province", "PROVINCE", "province_name", "PROVINCE_NAME", "provience", "PROVIENCE"));
        }

        function buildRegionProvincePairs(rows) {
            const pairs = [];

            for (const row of rows) {
                const region = getRegionValue(row);
                const province = getProvinceValue(row);

                if (!region && !province) continue;
                pairs.push({ region, province });
            }

            return pairs;
        }

        function setSelectValues(selectEl, values, allLabel, selectedValue, includeMissingSelected = true) {
            if (!selectEl) return;

            const selected = normalizeText(selectedValue);
            const deduped = [...new Set(values.filter(v => normalizeText(v) !== ""))]
                .sort((a, b) => a.localeCompare(b));

            if (includeMissingSelected && selected && !deduped.some(v => v.toLowerCase() === selected.toLowerCase())) {
                deduped.unshift(selected);
            }

            const options = [`<option value="">${allLabel}</option>`]
                .concat(deduped.map(value => `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`));

            selectEl.innerHTML = options.join("");
            selectEl.value = selected;
        }

        function syncRegionProvinceFilters(regionChanged = false) {
            const regionEl = document.getElementById("filterRegion");
            const provinceEl = document.getElementById("filterProvince");
            if (!regionEl || !provinceEl) return;

            const selectedRegion = normalizeText(regionEl.value);
            const selectedProvince = normalizeText(provinceEl.value);

            const regionsFromData = regionProvincePairs
                .map(pair => pair.region)
                .filter(Boolean);

            setSelectValues(regionEl, regionsFromData, "All regions", selectedRegion);

            const provincesFromData = regionProvincePairs
                .filter(pair => {
                    if (!selectedRegion) return true;
                    return normalizeText(pair.region).toLowerCase() === selectedRegion.toLowerCase();
                })
                .map(pair => pair.province)
                .filter(Boolean);

            const provinceStillValid = !selectedProvince || provincesFromData.some(
                p => normalizeText(p).toLowerCase() === selectedProvince.toLowerCase());
            const effectiveProvince = (regionChanged && !provinceStillValid) ? "" : selectedProvince;

            setSelectValues(provinceEl, provincesFromData, "All provinces", effectiveProvince, false);
        }

        // ✅ Sri Lanka bounding box (filters wrong coords)
        function isSriLanka(lat, lng) {
            return lat >= 5.5 && lat <= 10.5 && lng >= 79.0 && lng <= 82.5;
        }

        function getCoordKey(lat, lng) {
            return `${Number(lat).toFixed(6)},${Number(lng).toFixed(6)}`;
        }

        function getSpreadPosition(lat, lng, index, totalAtPoint) {
            if (!Number.isFinite(lat) || !Number.isFinite(lng)) return { lat, lng };
            if (!Number.isFinite(index) || index <= 0 || totalAtPoint <= 1) return { lat, lng };

            // Spiral offset so markers with identical coordinates are individually visible.
            const angle = (index * 137.5) * (Math.PI / 180);
            const ring = Math.floor(index / 6);
            const distanceMeters = 18 + (ring * 8);

            const deltaLat = (distanceMeters * Math.sin(angle)) / 111320;
            const safeCos = Math.max(0.2, Math.abs(Math.cos((lat * Math.PI) / 180)));
            const deltaLng = (distanceMeters * Math.cos(angle)) / (111320 * safeCos);

            return {
                lat: lat + deltaLat,
                lng: lng + deltaLng
            };
        }

        function buildFaultPopupHtml({
            carrier,
            cct,
            node,
            nodeName,
            carrierLat,
            carrierLng,
            areaLat,
            areaLng,
            faultTime,
            faultType,
            circuitType,
            cr,
            account,
            circuitName,
            circuitStatus,
            customerName,
            customerAddress,
            ipAddress,
            rGm,
            pDgm,
            region,
            province,
            faultText,
            
  Alarm_Time = "",
    AlarmDes = "",

            isUrgent,
            isPriority,
            viewMode,

            ceaShare
        }) {
            const priorityBanner = isPriority
                ? `<div class="priority-banner">Priority: fault number matches CX circuit name</div>`
                : "";

            const ceaSummary = (viewMode === "CEA Node")
                ? `
                    <div class="info-row mt-2">
                        <div class="info-icon">🧭</div>
                        <div>
                            <div class="info-label">CEA Shared Links</div>
                            <div class="info-value">${escapeHtml(String(ceaShare ?? 1))}</div>
                        </div>
                    </div>
                `
                : "";

            const resolvedCustomerName = customerName || (viewMode === "CEA Node" ? carrier : "");
            const sanitizedFaultText = sanitizeFaultDetailsText(faultText);
            const faultIdentifiers = parseCustomerFaultIdentifiers(faultText);
            const carrierLocation = formatLocationPoint(carrierLat, carrierLng);
            const correspondingArea = formatLocationPoint(areaLat, areaLng);
            const customerFaultView = isCustomerFaultMode() && viewMode === "Client Node";

            const resolvedRegion = normalizeText(region);
            const resolvedProvince = normalizeText(province);
            const resolvedEqNode = buildEqNodeDisplay(nodeName || node, ipAddress);
            const resolvedAccount = normalizeText(account);
            const resolvedCircuitStatus = normalizeText(circuitStatus);
            const resolvedCustomerAddress = normalizeText(customerAddress)
                || [resolvedProvince, resolvedRegion].filter(Boolean).join(", ");
            //const resolvedRGm = normalizeText(rGm) || resolvedRegion;
            //const resolvedPDgm = normalizeText(pDgm) || resolvedProvince;
            const resolvedRGm = getSafeValue(rGm, resolvedRegion || "Not Found");
const resolvedPDgm = getSafeValue(pDgm, resolvedProvince || "Not Found");
            const resolvedCircuitName = normalizeText(circuitName);
            const resolvedCircuitType = normalizeText(circuitType);

            if (customerFaultView) {
                return `
                    <div class="map-info-card customer-fault-popup">
                        <div class="customer-fault-banner"><span class="customer-fault-dot" aria-hidden="true"></span>Customer Fault</div>
                        <div class="info-section">
                            <div class="info-label mb-1">Fault Description</div>
                            <div class="info-fault-text customer-fault-text">${escapeHtml(sanitizedFaultText || "No fault description available")}</div>
                        </div>
                        <hr class="my-2"/>
                        <div class="info-section">
                            <div class="info-label mb-1">Core Information</div>
                            <div class="info-grid">
                                ${buildPopupDetailRow("Circuit", faultIdentifiers.cct || cct, true)}
                                ${buildPopupDetailRow("CR", cr, true)}
                                ${buildPopupDetailRow("Fault Time", faultTime)}
                            </div>
                        </div>
                        <hr class="my-2"/>
                        <div class="info-section">
                            <div class="info-label mb-1">Customer Fault Details</div>
                            <div class="info-grid customer-fault-details-grid">
                                ${buildPopupDetailRow("EQ Node", resolvedEqNode, true)}
                                ${buildPopupDetailRow("Account", resolvedAccount)}
                                ${buildPopupDetailRow("Circuit Status", resolvedCircuitStatus)}
                                ${buildPopupDetailRow("Customer Name", resolvedCustomerName)}
                                ${buildPopupDetailRow("Customer Address", resolvedCustomerAddress)}
                                ${buildPopupDetailRow("R-GM", resolvedRGm)}
                                ${buildPopupDetailRow("P-DGM", resolvedPDgm)}
                                ${buildPopupDetailRow("Alarm Time", Alarm_Time)}
                                ${buildPopupDetailRow("Alarm", AlarmDes)}

                            </div>
                        </div>
                    </div>
                `;
            }

            const locationBoxes = `
                <div class="info-section">
                    <div class="location-box-grid">
                        <div class="location-box-red">
                            <div class="info-label mb-1">Carrier Location</div>
                            <div class="info-value mono">${escapeHtml(carrierLocation)}</div>
                        </div>
                        <div class="location-box-red">
                            <div class="info-label mb-1">Connected CEA</div>
                            <div class="info-value mono">${escapeHtml(correspondingArea)}</div>
                        </div>
                    </div>
                </div>
            `;

            if (viewMode === "CEA Node") {
                const resolvedNodeName = nodeName || node;
                const ceaEqNodeDisplay = buildEqNodeDisplay(resolvedNodeName, ipAddress);

                return `
                    <div class="map-info-card">
                        ${priorityBanner}
                        <div class="info-section">
                            <div class="info-label mb-1">CEA Node Details</div>
                            <div class="info-grid">
                                <div class="info-kv"><span class="k">EQ Node</span><span class="v mono">${escapeHtml(ceaEqNodeDisplay) || "—"}</span></div>
                                <div class="info-kv"><span class="k">R-GM</span><span class="v">${escapeHtml(rGm) || "—"}</span></div>
                                <div class="info-kv"><span class="k">P-DGM</span><span class="v">${escapeHtml(pDgm) || "—"}</span></div>
                                <div class="info-kv"><span class="k">Fault Type</span><span class="v">${escapeHtml(faultType) || "—"}</span></div>
                                <div class="info-kv"><span class="k">Fault Time</span><span class="v">${escapeHtml(faultTime) || "—"}</span></div>
                            </div>
                        </div>
                        <hr class="my-2"/>
                        ${locationBoxes}
                        <hr class="my-2"/>
                        <div class="info-section">
                            <div class="info-label mb-1">Fault Information (NW Fault)</div>
                            <div class="info-fault-text">${escapeHtml(sanitizedFaultText)}</div>
                        </div>
                    </div>
                `;
            }

            const carrierEqNodeDisplay = buildEqNodeDisplay(nodeName || node, ipAddress);

            const headerBlock = (viewMode === "CEA Node")
                ? `
                    <div class="info-row">
                        <div class="info-icon">🗺️</div>
                        <div>
                            <div class="info-label">View</div>
                            <div class="info-value">${escapeHtml(viewMode)}</div>
                        </div>
                    </div>
                    ${ceaSummary}
                `
                : `
                    <div class="info-row">
                        <span class="info-carrier-icon">${carrierLogos[carrier] ?? "⚪"}</span>
                        <div>
                            <div class="info-label">Carrier</div>
                            <div class="info-value carrier-highlight">${escapeHtml(carrier)}</div>
                        </div>
                    </div>
                    ${ceaSummary}
                `;

            const topSummaryBlock = `
                <div class="popup-top-row">
                    <div class="popup-top-left">
                        ${headerBlock}
                    </div>
                    <div class="popup-circuit">
                        <div class="popup-circuit-item">
