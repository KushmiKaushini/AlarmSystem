@model AlarmSystem.Models.ViewModels.AlarmHistoryEngineerViewModel

@{
    ViewData["Title"] = "Alarm History - ALL";
}

<div class="container-fluid">

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">

            <h4 class="mb-0">
                Alarm History - ALL
            </h4>

        </div>

        <div class="card-body">

            <form asp-action="All" method="get">

                <div class="row mb-3">

                    <div class="col-md-3">

                        <label>From</label>

                        <input asp-for="From"
                               type="date"
                               class="form-control"/>

                    </div>

                    <div class="col-md-3">

                        <label>To</label>

                        <input asp-for="To"
                               type="date"
                               class="form-control"/>

                    </div>

                    <div class="col-md-3">

                        <label>Platform</label>

                        <select asp-for="Platform"
                                asp-items="Model.Platforms"
                                class="form-select">

                            <option value="">~ALL~</option>

                        </select>

                    </div>

                    <div class="col-md-3">

                        <label>Network Engineer</label>

                        <select asp-for="NetworkEngineer"
                                asp-items="Model.Engineers"
                                class="form-select">

                            <option value="">~ALL~</option>

                        </select>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-12">

                        <button class="btn btn-primary">

                            <i class="fa fa-search"></i>

                            Search

                        </button>

                        <a class="btn btn-success"
                           href="#">

                            <i class="fa fa-file-excel"></i>

                            Export Excel

                        </a>

                    </div>

                </div>

            </form>

            <hr/>

            <div class="table-responsive">

                <table class="table table-bordered table-hover table-striped">

                    <thead class="table-dark">

                    <tr>

                        <th>Node</th>

                        <th>Alarm</th>

                        <th>Alarm Type</th>

                        <th>Platform</th>

                        <th>Alarm Time</th>

                        <th>Close Time</th>

                        <th>NW Engineer</th>

                        <th>Province</th>

                        <th>Region</th>

                    </tr>

                    </thead>

                    <tbody>

                    @if(Model.Records.Any())
                    {
                        foreach(var item in Model.Records)
                        {

                            <tr>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id">

                                        @item.Node

                                    </a>

                                </td>

                                <td>

                                    @item.Alarm

                                </td>

                                <td>

                                    @item.AlarmType

                                </td>

                                <td>

                                    @item.Platform

                                </td>

                                <td>

                                    @item.AlarmTime

                                </td>

                                <td>

                                    @item.CloseTime

                                </td>

                                <td>

                                    @item.NetworkEngineer

                                </td>

                                <td>

                                    @item.Province

                                </td>

                                <td>

                                    @item.Region

                                </td>

                            </tr>

                        }
                    }
                    else
                    {

                        <tr>

                            <td colspan="9"
                                class="text-center">

                                No Records Found

                            </td>

                        </tr>

                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>