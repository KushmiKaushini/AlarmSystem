@model AlarmSystem.Models.ClarityFaultDetailsViewModel

@{
    ViewData["Title"] = "Clarity Fault Details";
}

<link rel="stylesheet" href="~/css/fault-details.css" />

<div class="container-fluid mt-4">

    <!-- Page Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold text-primary mb-1">
                CLARITY FAULT DETAILS
            </h2>

            <p class="text-muted mb-0">
                Telecom Network Operations Center
            </p>

        </div>

        <div>

            <a href="#"
               class="btn btn-danger btn-lg">

                <i class="fa fa-bolt"></i>

                ESCALATE

            </a>

        </div>

    </div>

    <!-- Summary Cards -->

    <div class="row g-3 mb-4">

        <div class="col-lg-3">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <small class="text-muted">
                        Clarity Reference
                    </small>

                    <h4 class="fw-bold mt-2">

                        @Model.Details.CLARITY_REF

                    </h4>

                </div>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <small class="text-muted">
                        Status
                    </small>

                    <h4 class="text-success fw-bold mt-2">

                        @Model.Details.STATUS

                    </h4>

                </div>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <small class="text-muted">
                        Priority
                    </small>

                    <h4 class="text-danger fw-bold mt-2">

                        @Model.Details.PRIORITY

                    </h4>

                </div>

            </div>

        </div>

        <div class="col-lg-3">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <small class="text-muted">
                        Work Group
                    </small>

                    <h4 class="fw-bold mt-2">

                        @Model.Details.WORKGROUP

                    </h4>

                </div>

            </div>

        </div>

    </div>

    <!-- Fault Details -->

    <div class="card shadow border-0 mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">

                Fault Information

            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-bold">

                        Customer

                    </label>

                    <input class="form-control"
                           readonly
                           value="@Model.Details.CUSTOMER" />

                </div>

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-bold">

                        Circuit

                    </label>

                    <input class="form-control"
                           readonly
                           value="@Model.Details.CIRCUIT" />

                </div>

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-bold">

                        Circuit Type

                    </label>

                    <input class="form-control"
                           readonly
                           value="@Model.Details.CIRCUIT_TYPE" />

                </div>

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-bold">

                        Nature

                    </label>

                    <input class="form-control"
                           readonly
                           value="@Model.Details.NATURE" />

                </div>

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-bold">

                        Reported Time

                    </label>

                    <input class="form-control"
                           readonly
                           value="@Model.Details.REPORTED_TIME" />

                </div>

                <div class="col-md-6 mb-3">

                    <label class="form-label fw-bold">

                        SLA Type

                    </label>

                    <input class="form-control"
                           readonly
                           value="@Model.Details.SLA_TYPE" />

                </div>

                <div class="col-md-12 mb-3">

                    <label class="form-label fw-bold">

                        Description

                    </label>

                    <textarea class="form-control"
                              rows="4"
                              readonly>@Model.Details.DESCRIPTION</textarea>

                </div>

            </div>

        </div>

    </div>

    <!-- PART 3B starts here -->

        <!-- WORK ORDERS -->

    <div class="card shadow border-0 mb-4">

        <div class="card-header bg-success text-white">

            <h5 class="mb-0">

                Work Orders

            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover table-striped mb-0">

                    <thead class="table-dark">

                        <tr>

                            <th>WO REF</th>
                            <th>STATUS</th>
                            <th>STARTED TIME</th>
                            <th>WORK GROUP</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.WorkOrders.Any())
                        {
                            foreach (var item in Model.WorkOrders)
                            {
                                <tr>

                                    <td>@item.WO_REF</td>

                                    <td>

                                        <span class="badge bg-success">

                                            @item.WO_STATUS

                                        </span>

                                    </td>

                                    <td>

                                        @(item.STARTED_TIME?.ToString("dd-MMM-yyyy HH:mm"))

                                    </td>

                                    <td>

                                        @item.WORK_GROUP

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center text-muted py-4">

                                    No Work Orders Found

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>



    <!-- COMMENTS -->

    <div class="card shadow border-0">

        <div class="card-header bg-info text-white">

            <h5 class="mb-0">

                Fault History / Comments

            </h5>

        </div>

        <div class="card-body">

            @if (Model.Comments.Any())
            {
                foreach (var item in Model.Comments)
                {
                    <div class="timeline-item">

                        <div class="timeline-dot"></div>

                        <div class="timeline-content">

                            <div class="d-flex
                                        justify-content-between
                                        align-items-center">

                                <strong>

                                    @(item.EVENT_TIME?.ToString("dd-MMM-yyyy HH:mm"))

                                </strong>

                            </div>

                            <p class="mb-0 mt-2">

                                @item.TEXT

                            </p>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="text-center py-4">

                    <h5 class="text-muted">

                        No Comments Available

                    </h5>

                </div>
            }

        </div>

    </div>



    <div class="mt-4 text-end">

        <a asp-controller="FaultDockets"
           asp-action="Index"
           class="btn btn-secondary">

            <i class="fa fa-arrow-left"></i>

            Back to Fault Dockets

        </a>

    </div>

</div>