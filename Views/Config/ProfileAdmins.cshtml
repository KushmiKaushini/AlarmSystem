@model List<AlarmSystem.Services.ProfileAdminItem>

@{
    ViewData["Title"] = "Add / Remove Profile Admin";
    var adminCount = Model != null ? Model.Count : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/config-dashboard.css" asp-append-version="true" />
    <style>
        .admin-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0284c7, #0369a1);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .badge-profile-admin {
            background: linear-gradient(135deg, #0284c7, #0369a1);
            color: #ffffff;
            font-weight: 700;
            padding: 6px 12px;
            border-radius: 50px;
            font-size: 0.8rem;
        }
    </style>
}

<div class="config-page">

    <!-- BACK TO CONFIG HUB -->
    <a asp-controller="Config" asp-action="Index" class="config-back-btn">
        <i class="fa-solid fa-arrow-left"></i> Back to Config Hub
    </a>

    <!-- HERO HEADER -->
    <div class="config-hero mb-4">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div class="hero-left">
                <div class="hero-icon" style="background: rgba(2, 132, 199, 0.2); color: #38bdf8;">
                    <i class="fa-solid fa-users-gear"></i>
                </div>
                <div>
                    <h1>Add / Remove Profile Admin</h1>
                    <p>Search employee records, delegate profile administration rights &amp; manage active profile administrators</p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 bg-white bg-opacity-10 px-4 py-2 rounded-pill">
                <span class="small text-white-50">Security Access Level:</span>
                <span class="badge bg-info text-dark rounded-pill px-3 py-2 fw-bold">Profile Admin Tier</span>
            </div>
        </div>
    </div>

    <!-- MAIN TWO COLUMN LAYOUT -->
    <div class="row g-4">

        <!-- LEFT COLUMN: ADD PROFILE ADMIN FORM -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="p-3 bg-info-subtle text-info rounded-3">
                        <i class="fa-solid fa-user-shield fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold m-0 text-dark">Add Profile Admin</h5>
                        <small class="text-muted">Search employee &amp; assign a managed profile</small>
                    </div>
                </div>

                <form id="addProfileAdminForm" onsubmit="handleAddProfileAdmin(event)">

                    <!-- SERVICE NO SEARCH ROW -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary small uppercase">Service No</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-id-card text-muted"></i></span>
                            <input type="text" id="profAdminServiceNo" class="form-control form-control-lg border-start-0 border-end-0 ps-0" placeholder="Enter Service No..." required />
                            <button class="btn btn-info text-dark px-3 fw-bold" type="button" onclick="searchProfileAdminByServiceNo()">
                                <i class="fa-solid fa-search me-1"></i> SEARCH
                            </button>
                        </div>
                    </div>

                    <!-- EMPLOYEE NAME DISPLAY / RESULT -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary small uppercase">Employee Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-user text-muted"></i></span>
                            <input type="text" id="profAdminName" class="form-control form-control-lg border-start-0 ps-0 bg-light" placeholder="Click Search to retrieve name..." readonly required />
                        </div>
                    </div>

                    <!-- PROFILE SELECTOR -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary small uppercase">Assign Profile</label>
                        <select id="profAdminProfileSelect" class="form-select form-select-lg text-dark fw-semibold" required>
                            <option value="">— Select Managed Profile —</option>
                            <option value="ISP">ISP Profile</option>
                            <option value="EHD">EHD Profile</option>
                            <option value="IPNWOP">IPNWOP Profile</option>
                            <option value="DATACOM">DATACOM Profile</option>
                            <option value="SALES">SALES Profile</option>
                            <option value="RTSU">RTSU Profile</option>
                            <option value="BROADBAND">BROADBAND Profile</option>
                            <option value="Regions">Regions Profile</option>
                            <option value="RandD">RandD Profile</option>
                            <option value="SAT">SAT Profile</option>
                            <option value="PowerAC">PowerAC Profile</option>
                        </select>
                    </div>

                    <!-- SUBMIT BUTTON -->
                    <button type="submit" class="btn btn-info text-dark btn-lg w-100 rounded-3 fw-bold shadow-sm mb-3">
                        <i class="fa-solid fa-user-plus me-2"></i> ADD PROFILE ADMIN
                    </button>

                    <!-- STATUS MESSAGE ALERT -->
                    <div id="statusAlertMessage" class="alert d-none rounded-3 py-2 px-3 mb-0 small fw-bold"></div>

                </form>
            </div>
        </div>

        <!-- RIGHT COLUMN: PROFILE ADMINS LIST -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="fw-bold m-0 text-dark">
                            <i class="fa-solid fa-users-gear text-info me-2"></i> Active Profile Administrators
                        </h5>
                        <small class="text-muted">Current accounts with administrative rights for assigned profiles</small>
                    </div>
                    <span id="profileAdminCountBadge" class="badge bg-info text-dark rounded-pill px-3 py-2 fs-6">@adminCount Profile Admins</span>
                </div>

                <!-- TABLE SEARCH FILTER -->
                <div class="mb-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-filter text-muted"></i></span>
                        <input type="text" id="filterAdminsInput" class="form-control border-start-0" placeholder="Filter by Service No, Name, or Profile..." onkeyup="filterAdminsTable()" />
                    </div>
                </div>

                <!-- PROFILE ADMINS TABLE -->
                <div class="table-responsive rounded-3 border">
                    <table class="table table-hover align-middle mb-0" id="profileAdminsTable">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Service No</th>
                                <th>Name</th>
                                <th>Managed Profile</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="profileAdminsTbody">
                            @if (Model != null && Model.Any())
                            {
                                int idx = 1;
                                foreach (var admin in Model)
                                {
                                    var initials = string.Join("", (admin.Name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper();
                                    if (initials.Length > 2) { initials = initials.Substring(0, 2); }
                                    if (string.IsNullOrEmpty(initials)) { initials = "PA"; }

                                    <tr>
                                        <td class="text-muted fw-bold">@idx</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="admin-avatar">@initials</div>
                                                <span class="fw-bold text-dark">@admin.ServiceNo</span>
                                            </div>
                                        </td>
                                        <td class="fw-semibold">@admin.Name</td>
                                        <td><span class="badge badge-profile-admin">@admin.ProfileName Profile</span></td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="revokeProfileAdmin(this, '@admin.ServiceNo', '@admin.Name', '@admin.ProfileName')">
                                                <i class="fa-solid fa-trash-can me-1"></i> Revoke
                                            </button>
                                        </td>
                                    </tr>
                                    idx++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">No profile administrators found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        function searchProfileAdminByServiceNo() {
            const serviceNoInput = document.getElementById('profAdminServiceNo');
            const nameInput = document.getElementById('profAdminName');

            const rawServiceNo = serviceNoInput.value.trim();
            if (!rawServiceNo) {
                showStatusMessage("Please enter a valid Service No.", "danger");
                nameInput.value = "";
                return;
            }

            fetch('/Config/GetEmployeeName?serviceNo=' + encodeURIComponent(rawServiceNo))
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.name) {
                        nameInput.value = data.name;
                        showStatusMessage("Employee record found: " + data.name, "success");
                    } else {
                        nameInput.value = "";
                        showStatusMessage("Invalid Service No or record not found.", "danger");
                    }
                })
                .catch(err => {
                    showStatusMessage("Error querying employee database.", "danger");
                });
        }

        function handleAddProfileAdmin(e) {
            e.preventDefault();

            const serviceNoInput = document.getElementById('profAdminServiceNo');
            const nameInput = document.getElementById('profAdminName');
            const profileSelect = document.getElementById('profAdminProfileSelect');

            const serviceNo = serviceNoInput.value.trim();
            const name = nameInput.value.trim();
            const profile = profileSelect.value;

            if (!name || name === "") {
                showStatusMessage("ERROR ADDING PROFILE ADMIN: Valid employee name is required.", "danger");
                return;
            }

            if (!profile) {
                showStatusMessage("Please select a profile to assign.", "warning");
                return;
            }

            const tbody = document.getElementById('profileAdminsTbody');
            const newRowIndex = tbody.querySelectorAll('tr').length + 1;
            const initials = getInitials(name);

            const tr = document.createElement('tr');
            tr.innerHTML = '<td class="text-muted fw-bold">' + newRowIndex + '</td>' +
                '<td><div class="d-flex align-items-center gap-2">' +
                '<div class="admin-avatar">' + initials + '</div>' +
                '<span class="fw-bold text-dark">' + escapeHtml(serviceNo) + '</span>' +
                '</div></td>' +
                '<td class="fw-semibold">' + escapeHtml(name) + '</td>' +
                '<td><span class="badge badge-profile-admin">' + escapeHtml(profile) + ' Profile</span></td>' +
                '<td class="text-center">' +
                '<button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="revokeProfileAdmin(this, \'' + escapeHtml(serviceNo) + '\', \'' + escapeHtml(name) + '\', \'' + escapeHtml(profile) + '\')">' +
                '<i class="fa-solid fa-trash-can me-1"></i> Revoke</button>' +
                '</td>';

            tbody.appendChild(tr);

            serviceNoInput.value = "";
            nameInput.value = "";
            profileSelect.selectedIndex = 0;

            showStatusMessage("SUCCESS: " + name + " assigned as Profile Admin for " + profile + ".", "success");
            updateProfileAdminCount();
        }

        function revokeProfileAdmin(btn, serviceNo, name, profile) {
            if (confirm("Are you sure you want to revoke Profile Admin access for " + name + " (" + profile + ")?")) {
                const row = btn.closest('tr');
                row.remove();
                showStatusMessage("Revoked Profile Admin access for " + name + ".", "warning");
                updateProfileAdminCount();
            }
        }

        function filterAdminsTable() {
            const input = document.getElementById('filterAdminsInput').value.toLowerCase();
            const rows = document.querySelectorAll('#profileAdminsTbody tr');

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(input) ? '' : 'none';
            });
        }

        function updateProfileAdminCount() {
            const count = document.querySelectorAll('#profileAdminsTbody tr').length;
            const badge = document.getElementById('profileAdminCountBadge');
            if (badge) {
                badge.textContent = count + " Profile Admins";
            }
        }

        function showStatusMessage(message, type) {
            const alertBox = document.getElementById('statusAlertMessage');
            alertBox.className = "alert rounded-3 py-2 px-3 mb-0 small fw-bold alert-" + type;
            alertBox.textContent = message;
            alertBox.classList.remove('d-none');
        }

        function getInitials(name) {
            return name.trim().split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase();
        }

        function escapeHtml(str) {
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
    </script>
}
