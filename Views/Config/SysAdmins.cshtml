@model List<AlarmSystem.Services.SysAdminItem>

@{
    ViewData["Title"] = "Sys Admins Management";
    var adminCount = Model != null ? Model.Count : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/config-dashboard.css" asp-append-version="true" />
    <style>
        .admin-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: #ffffff;
            font-weight: 700;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .badge-super-admin {
            background: linear-gradient(135deg, #dc2626, #b91c1c);
            color: white;
            font-weight: 700;
            letter-spacing: 0.5px;
            padding: 6px 12px;
            border-radius: 50px;
        }

        .search-badge {
            background: rgba(79, 70, 229, 0.1);
            color: #4f46e5;
            border: 1px solid rgba(79, 70, 229, 0.2);
            border-radius: 8px;
            padding: 8px 12px;
            font-size: 0.9rem;
            font-weight: 600;
        }
    </style>
}

<div class="config-page">

    <!-- BACK TO CONFIG HUB -->
    <a asp-controller="Config" asp-action="Index" class="config-back-btn">
        <i class="fa-solid fa-arrow-left"></i> Back to Config Hub
    </a>

    <!-- HERO HEADER -->
    <div class="config-hero mb-4">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div class="hero-left">
                <div class="hero-icon" style="background: rgba(220, 38, 38, 0.2); color: #f87171;">
                    <i class="fa-solid fa-user-shield"></i>
                </div>
                <div>
                    <h1>Sys Admins Management</h1>
                    <p>System Administrator Access, Super Admin Roles &amp; Security Privilege Management</p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 bg-white bg-opacity-10 px-4 py-2 rounded-pill">
                <span class="small text-white-50">Security Access Level:</span>
                <span class="badge bg-danger rounded-pill px-3 py-2 fw-bold">Super Admin Tier</span>
                <span class="badge bg-primary rounded-pill px-3 py-2 fw-bold ms-2"><i class="fa-brands fa-microsoft me-1"></i> Azure AD Cloud</span>
            </div>
        </div>
    </div>

    <!-- MAIN TWO COLUMN LAYOUT -->
    <div class="row g-4">

        <!-- LEFT COLUMN: ADD NEW SUPER ADMIN FORM -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="p-3 bg-danger-subtle text-danger rounded-3">
                        <i class="fa-solid fa-user-plus fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold m-0 text-dark">New Super Admin</h5>
                        <small class="text-muted">Search employee records &amp; grant Super Admin privileges</small>
                    </div>
                </div>

                <form id="addSuperAdminForm" onsubmit="handleAddSuperAdmin(event)">

                    <!-- SERVICE NO SEARCH ROW -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-secondary small uppercase">Service No</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-id-card text-muted"></i></span>
                            <input type="text" id="sysAdminServiceNo" class="form-control form-control-lg border-start-0 border-end-0 ps-0" placeholder="Enter Service No..." required />
                            <button class="btn btn-danger px-3 fw-bold" type="button" onclick="searchSuperAdminByServiceNo()">
                                <i class="fa-solid fa-search me-1"></i> SEARCH
                            </button>
                        </div>
                    </div>

                    <!-- EMPLOYEE NAME DISPLAY / RESULT -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-secondary small uppercase">Employee Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-user text-muted"></i></span>
                            <input type="text" id="sysAdminName" class="form-control form-control-lg border-start-0 ps-0 bg-light" placeholder="Click Search to retrieve name..." readonly required />
                        </div>
                        <div id="nameStatusHint" class="small text-muted mt-1">
                            <i class="fa-solid fa-circle-info me-1"></i>Enter Service No and click Search to pull employee name from database / Active Directory.
                        </div>
                    </div>

                    <!-- SUBMIT BUTTON -->
                    <button type="submit" class="btn btn-danger btn-lg w-100 rounded-3 fw-bold shadow-sm mb-3">
                        <i class="fa-solid fa-user-shield me-2"></i> ADD SUPER ADMIN
                    </button>

                    <!-- STATUS MESSAGE ALERT -->
                    <div id="statusAlertMessage" class="alert d-none rounded-3 py-2 px-3 mb-0 small fw-bold"></div>

                </form>
            </div>
        </div>

        <!-- RIGHT COLUMN: SUPER ADMINS LIST -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="fw-bold m-0 text-dark">
                            <i class="fa-solid fa-users-gear text-danger me-2"></i> Active Super Administrators
                        </h5>
                        <small class="text-muted">Current accounts with full system administration rights</small>
                    </div>
                    <span id="superAdminCountBadge" class="badge bg-danger rounded-pill px-3 py-2 fs-6">@adminCount Super Admins</span>
                </div>

                <!-- TABLE SEARCH FILTER -->
                <div class="mb-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-filter text-muted"></i></span>
                        <input type="text" id="filterAdminsInput" class="form-control border-start-0" placeholder="Filter super admins by Service No or Name..." onkeyup="filterAdminsTable()" />
                    </div>
                </div>

                <!-- SUPER ADMINS TABLE (Connected to DB Model) -->
                <div class="table-responsive rounded-3 border">
                    <table class="table table-hover align-middle mb-0" id="superAdminsTable">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Service No</th>
                                <th>Name</th>
                                <th>Azure Account</th>
                                <th>Role</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody id="superAdminsTbody">
                            @if (Model != null && Model.Any())
                            {
                                int idx = 1;
                                foreach (var admin in Model)
                                {
                                    var initials = string.Join("", (admin.Name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(s => s[0])).ToUpper();
                                    if (initials.Length > 2) { initials = initials.Substring(0, 2); }
                                    if (string.IsNullOrEmpty(initials)) { initials = "SA"; }

                                    <tr>
                                        <td class="text-muted fw-bold">@idx</td>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="admin-avatar">@initials</div>
                                                <span class="fw-bold text-dark">@admin.ServiceNo</span>
                                            </div>
                                        </td>
                                        <td class="fw-semibold">@admin.Name</td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill small">
                                                <i class="fa-brands fa-microsoft me-1"></i> @admin.AzureAccount
                                            </span>
                                        </td>
                                        <td><span class="badge badge-super-admin">@admin.Role</span></td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="deleteSuperAdmin(this, '@admin.ServiceNo', '@admin.Name')">
                                                <i class="fa-solid fa-trash me-1"></i> Delete
                                            </button>
                                        </td>
                                    </tr>
                                    idx++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">No system administrators found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        function searchSuperAdminByServiceNo() {
            const serviceNoInput = document.getElementById('sysAdminServiceNo');
            const nameInput = document.getElementById('sysAdminName');
            const alertBox = document.getElementById('statusAlertMessage');

            alertBox.classList.add('d-none');
            const rawServiceNo = serviceNoInput.value.trim();

            if (!rawServiceNo) {
                showStatusMessage("Please enter a valid Service No.", "danger");
                nameInput.value = "";
                return;
            }

            fetch('/Config/GetEmployeeName?serviceNo=' + encodeURIComponent(rawServiceNo))
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.name) {
                        nameInput.value = data.name;
                        showStatusMessage("Employee record found: " + data.name, "success");
                    } else {
                        nameInput.value = "";
                        showStatusMessage("Invalid Service No or record not found.", "danger");
                    }
                })
                .catch(err => {
                    showStatusMessage("Error querying employee database.", "danger");
                });
        }

        function handleAddSuperAdmin(e) {
            e.preventDefault();

            const serviceNoInput = document.getElementById('sysAdminServiceNo');
            const nameInput = document.getElementById('sysAdminName');

            const serviceNo = serviceNoInput.value.trim();
            const name = nameInput.value.trim();

            if (!name || name === "") {
                showStatusMessage("ERROR ADDING SUPER ADMIN: Valid employee name is required.", "danger");
                return;
            }

            const tbody = document.getElementById('superAdminsTbody');
            const newRowIndex = tbody.querySelectorAll('tr').length + 1;
            const initials = getInitials(name);

            const tr = document.createElement('tr');
            tr.innerHTML = '<td class="text-muted fw-bold">' + newRowIndex + '</td>' +
                '<td><div class="d-flex align-items-center gap-2">' +
                '<div class="admin-avatar">' + initials + '</div>' +
                '<span class="fw-bold text-dark">' + escapeHtml(serviceNo) + '</span>' +
                '</div></td>' +
                '<td class="fw-semibold">' + escapeHtml(name) + '</td>' +
                '<td><span class="badge badge-super-admin">Super Admin</span></td>' +
                '<td class="text-center">' +
                '<button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="deleteSuperAdmin(this, \'' + escapeHtml(serviceNo) + '\', \'' + escapeHtml(name) + '\')">' +
                '<i class="fa-solid fa-trash me-1"></i> Delete</button>' +
                '</td>';

            tbody.appendChild(tr);

            serviceNoInput.value = "";
            nameInput.value = "";

            showStatusMessage("SUCCESS: " + name + " (" + serviceNo + ") granted Super Admin privileges.", "success");
            updateSuperAdminCount();
        }

        function deleteSuperAdmin(btn, serviceNo, name) {
            if (confirm("Are you sure you want to revoke Super Admin privileges for " + name + " (" + serviceNo + ")?")) {
                const row = btn.closest('tr');
                row.remove();
                showStatusMessage("Revoked Super Admin access for " + name + " (" + serviceNo + ").", "warning");
                updateSuperAdminCount();
            }
        }

        function filterAdminsTable() {
            const input = document.getElementById('filterAdminsInput').value.toLowerCase();
            const rows = document.querySelectorAll('#superAdminsTbody tr');

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(input) ? '' : 'none';
            });
        }

        function updateSuperAdminCount() {
            const count = document.querySelectorAll('#superAdminsTbody tr').length;
            const badge = document.getElementById('superAdminCountBadge');
            if (badge) {
                badge.textContent = count + " Super Admins";
            }
        }

        function showStatusMessage(message, type) {
            const alertBox = document.getElementById('statusAlertMessage');
            alertBox.className = "alert rounded-3 py-2 px-3 mb-0 small fw-bold alert-" + type;
            alertBox.textContent = message;
            alertBox.classList.remove('d-none');
        }

        function getInitials(name) {
            return name.trim().split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase();
        }

        function escapeHtml(str) {
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
    </script>
}
