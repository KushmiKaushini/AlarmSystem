@model AlarmSystem.Models.History.HistoryTicket

@{
    ViewData["Title"] = "History Details";
}

<h2 class="mb-3">ESCALATION HISTORY DETAILS</h2>

<div class="row">

    <div class="col-md-6">

        <table class="table table-bordered">

            <tr>
                <th>Ticket ID</th>
                <td>@Model.ID</td>
            </tr>

            <tr>
                <th>Node</th>
                <td>@Model.NODE</td>
            </tr>

            <tr>
                <th>Severity</th>
                <td>@Model.SEVERITY</td>
            </tr>

            <tr>
                <th>Platform</th>
                <td>@Model.PLATFORM</td>
            </tr>

            <tr>
                <th>Tag</th>
                <td>@Model.TAG</td>
            </tr>

            <tr>
                <th>Description</th>
                <td>@Model.DESCRIPTION</td>
            </tr>

            <tr>
                <th>Status</th>
                <td>@Model.STATUS</td>
            </tr>

        </table>

    </div>

    <div class="col-md-6">

        <table class="table table-bordered">

            <tr>
                <th>Issue Time</th>
                <td>@Model.ISSUE_TIME</td>
            </tr>

            <tr>
                <th>Reporting Time</th>
                <td>@Model.REPORTING_TIME</td>
            </tr>

            <tr>
                <th>Responsible Officer</th>
                <td>@Model.RESPONSIBLE_OFFICER</td>
            </tr>

            <tr>
                <th>Workgroup</th>
                <td>@Model.WORKGROUP</td>
            </tr>

            <tr>
                <th>Reporting By</th>
                <td>@Model.REPORTING_BY</td>
            </tr>

            <tr>
                <th>Creation Method</th>
                <td>@Model.CREATION_METHOD</td>
            </tr>

        </table>

    </div>

</div>

<hr />

<h3>Attributes</h3>

<table class="table table-bordered table-striped">

    <thead class="table-dark">
        <tr>
            <th>Key</th>
            <th>Value</th>
        </tr>
    </thead>

    <tbody>

@foreach (var item in (List<AlarmSystem.Models.History.HistoryAttribute>)ViewBag.Attributes)
{
    <tr>
        <td>@item.KEY_FIELD</td>
        <td>@item.VALUE_FIELD</td>
    </tr>
}

    </tbody>

</table>

<hr />

<h3>Comments</h3>

<table class="table table-bordered table-striped">

    <thead class="table-dark">
        <tr>
            <th>Comment</th>
            <th>Comment By</th>
            <th>Comment Time</th>
        </tr>
    </thead>

    <tbody>

@foreach (var item in (List<AlarmSystem.Models.History.HistoryComment>)ViewBag.Comments)
{
    <tr>

        <td>@item.COMMENT_TEXT</td>

        <td>@item.COMMENT_BY</td>

        <td>@item.COMMENT_TIME</td>

    </tr>
}

    </tbody>

</table>

<hr />

<h3>Escalation History</h3>

<table class="table table-bordered table-hover table-striped">

    <thead class="table-dark">

        <tr>

            <th>Group</th>

            <th>Escalation Time</th>

            <th>Escalated By</th>

            <th>Level</th>

        </tr>

    </thead>

    <tbody>

@foreach (var item in (List<AlarmSystem.Models.History.HistoryEscalationPrimary>)ViewBag.Escalations)
{
    <tr>

        <td>

            <a asp-controller="History"
               asp-action="EscalationDetails"
               asp-route-escId="@item.ID">

                @item.GROUP_NAME

            </a>

        </td>

        <td>@item.ESCALATION_TIME</td>

        <td>@item.ESCALATE_BY_NAME</td>

        <td>@item.ESCALATION_LEVEL</td>

    </tr>
}

    </tbody>

</table>

<div class="mt-3">

    <a asp-action="Index"
       class="btn btn-secondary">

        Back

    </a>

</div>