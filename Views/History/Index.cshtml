@model List<AlarmSystem.Models.History.HistoryTicket>

@{
    ViewData["Title"] = "Escalation History";
}

<h2 class="mb-3">ESCALATION HISTORY</h2>

<form asp-action="Index" method="get">

    <div class="row mb-3">

        <div class="col-md-3">

            <label><b>From</b></label>

            <input type="date"
                   name="from"
                   class="form-control"
                   value="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))" />

        </div>

        <div class="col-md-3">

            <label><b>To</b></label>

            <input type="date"
                   name="to"
                   class="form-control"
                   value="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))" />

        </div>

        <div class="col-md-3">

            <label><b>Ticket Type</b></label>

            <select name="ticketType" class="form-select">

                <option value="FAULT"
                        selected="@(ViewBag.TicketType=="FAULT")">
                    FAULT
                </option>

                <option value="PM"
                        selected="@(ViewBag.TicketType=="PM")">
                    PM
                </option>

            </select>

        </div>

        <div class="col-md-3">

            <br />

            <button class="btn btn-primary w-100">
                SEARCH
            </button>

        </div>

    </div>

</form>

<hr />

<table class="table table-bordered table-striped table-hover">

    <thead class="table-dark">

        <tr>

            <th>NODE</th>
            <th>SEVERITY</th>
            <th>TAG</th>
            <th>PLATFORM</th>
            <th>DESCRIPTION</th>
            <th>ISSUE TIME</th>
            <th>REPORTING TIME</th>
            <th>STATUS</th>
            <th>RESPONSIBLE OFFICER</th>

        </tr>

    </thead>

    <tbody>

@foreach (var item in Model)
{
    <tr>

        <td>

            <a asp-controller="History"
               asp-action="Details"
               asp-route-id="@item.ID">

                @item.NODE

            </a>

        </td>

        <td>@item.SEVERITY</td>

        <td>@item.TAG</td>

        <td>@item.PLATFORM</td>

        <td>@item.DESCRIPTION</td>

        <td>@item.ISSUE_TIME</td>

        <td>@item.REPORTING_TIME</td>

        <td>@item.STATUS</td>

        <td>@item.RESPONSIBLE_OFFICER</td>

    </tr>
}

    </tbody>

</table>