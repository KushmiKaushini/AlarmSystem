# Database Connections
ConnectionStrings__NewDB=Server=localhost;Database=NewDB;Trusted_Connection=True;TrustServerCertificate=True;
ConnectionStrings__TMS=Server=localhost;Database=NewDB;Trusted_Connection=True;TrustServerCertificate=True;

# Email Reporting SMTP Configuration
EmailReporting__Smtp__Host=smtp.office365.com
EmailReporting__Smtp__Port=587
EmailReporting__Smtp__Username=your-email@slt.com.lk
EmailReporting__Smtp__Password=your-email-password
EmailReporting__Smtp__FromAddress=no-reply@slt.com.lk
EmailReporting__Smtp__EnableSsl=true

# Recipient Overrides (Semicolon or comma separated)
EmailReporting__DefaultRecipient=network.engineer@slt.com.lk
EmailReporting__Recipients__1=
EmailReporting__Recipients__2=
EmailReporting__Recipients__3=
EmailReporting__Recipients__4=
