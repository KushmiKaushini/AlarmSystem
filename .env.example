# ==============================================================================
# ALARM SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values.
# ==============================================================================

# Application Base URL (used in email report action links and downloads)
EmailReporting__AppBaseUrl=http://localhost:5200

# SMTP Server Configuration
EmailReporting__Smtp__Host=smtp.office365.com
EmailReporting__Smtp__Port=587
EmailReporting__Smtp__Username=your-email@slt.com.lk
EmailReporting__Smtp__Password=your-smtp-password-or-app-password
EmailReporting__Smtp__EnableSsl=true
EmailReporting__Smtp__FromAddress=no-reply@slt.com.lk

# Email Automation Scheduler Settings
EmailReporting__Enabled=true
EmailReporting__WorkingDaysOnly=true
EmailReporting__StartHour=7
EmailReporting__EndHour=17
EmailReporting__IntervalHours=1

# Email Recipients (use semicolons ';' to separate multiple addresses)
EmailReporting__DefaultRecipient=network.engineer@slt.com.lk
EmailReporting__Recipients__Default=network.engineer@slt.com.lk
EmailReporting__Recipients__NetworkEngineer=network.engineer@slt.com.lk
EmailReporting__Recipients__1=regional-team@slt.com.lk
EmailReporting__Recipients__2=opmc-team@slt.com.lk
EmailReporting__Recipients__3=noc-team@slt.com.lk
EmailReporting__Recipients__4=failures-team@slt.com.lk

# Daily Schedule Times (HH:mm in 24-hour format)
EmailReporting__Schedule__1=07:00
EmailReporting__Schedule__2=07:00
EmailReporting__Schedule__3=07:00
EmailReporting__Schedule__4=07:00
